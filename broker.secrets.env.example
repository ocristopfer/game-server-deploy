# Broker secrets. Copy to broker.secrets.env (it is in .gitignore) and fill it in.
#
#   Copy-Item broker.secrets.env.example broker.secrets.env
#   .\deploy\broker\check-broker-access.ps1
#
# NEVER paste these values into a chat, an issue or a commit. Proxmox and OPNsense show the
# secret ONLY ONCE: if you lose it, generate another one.

# ===== Proxmox =====
PROXMOX_URL=https://10.20.0.2:8006
# Full format: user@realm!token-name=SECRET-UUID
PROXMOX_TOKEN=broker@pve!broker=COLE_O_SEGREDO_AQUI
# Node name (the one shown in the Proxmox tree). REQUIRED for the broker deploy.
PROXMOX_NODE=
PROXMOX_POOL=games
PROXMOX_STORAGE=local-lvm
PROXMOX_TEMPLATE_STORAGE=local
# Template for the game CTs (full volid). Empty = the newest debian-13-standard in the storage.
# PROXMOX_TEMPLATE=local:vztmpl/debian-13-standard_13.6-1_amd64.tar.zst
# SHA-256 fingerprint of the Proxmox certificate. Empty = the deploy reads it from the server and
# prints it for you to CHECK (check-broker-access.ps1 prints it too).
# PROXMOX_CERT_SHA256=
PROXMOX_BRIDGE=vmbr0

# ===== OPNsense =====
OPNSENSE_URL=https://IP_DO_OPNSENSE
OPNSENSE_KEY=COLE_A_KEY_AQUI
OPNSENSE_SECRET=COLE_O_SECRET_AQUI
# Name of the WAN interface (the identifier, e.g. wan), where the port forwards are created.
OPNSENSE_WAN=wan
# OPNSENSE_CERT_SHA256=

# ===== Steam account (optional) =====
# Only for games that cannot be downloaded with an anonymous login (today, DayZ). Without both,
# that game stays "manual" in the catalog; with only one, the broker does NOT start (it says
# which one is missing).
# Use an account DEDICATED to servers, that owns the game and has NO Steam Guard: every new CT
# is a new computer for Steam, and the login happens minutes after the request - there is
# nobody there to type a code. Never your personal account: the password ends up living in the
# broker.
# Password without spaces and without single quotes (the SteamCMD command line would break on them).
# STEAM_USER=
# STEAM_PASS=
