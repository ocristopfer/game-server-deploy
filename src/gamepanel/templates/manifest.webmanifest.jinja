{
  "id": "/",
  "name": {{ _('app.name') | tojson }},
  "short_name": {{ _('app.short_name') | tojson }},
  "description": {{ _('app.description') | tojson }},
  "lang": {{ html_lang | tojson }},
  "dir": "ltr",
  "start_url": "/?fonte=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0f1216",
  "theme_color": "#171c22",
  "categories": ["utilities", "productivity"],
  "icons": [
    {
      "src": "{{ url_for('static', filename='icons/icon-192.png') }}",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "{{ url_for('static', filename='icons/icon-512.png') }}",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "{{ url_for('static', filename='icons/icon-maskable-512.png') }}",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": {{ _('nav.servers') | tojson }},
      "url": "{{ url_for('dashboard.index') }}",
      "icons": [{ "src": "{{ url_for('static', filename='icons/icon-192.png') }}", "sizes": "192x192" }]
    },
    {
      "name": {{ _('nav.history') | tojson }},
      "url": "{{ url_for('history.index') }}"
    }
  ]
}
