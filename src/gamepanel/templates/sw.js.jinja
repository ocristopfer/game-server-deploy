/* Game Panel service worker.
 *
 * This file is SERVED BY FLASK (not from /static/) for two reasons:
 *
 *   1. a service worker's scope is the folder it lives in - served from
 *      /static/sw.js it would only see /static/, and not the panel navigation;
 *   2. the VERSION below is stamped at serve time, from the mtime of the
 *      static files. A new byte in the CSS = a different worker file = the
 *      browser installs the new version and throws away the old cache. Without that, a
 *      deploy reaches someone's phone as "the screen broke after the update".
 *
 * WHAT THIS WORKER DOES NOT DO, on purpose:
 *
 *   - it does not store HTML of a logged-in page. The panel grants root power over the containers and
 *     runs with several users; a server screen stored in the cache could
 *     reappear after logout, or for the wrong person on the same device. The
 *     navigation always goes to the network, and a failure falls to the "no connection" page.
 *   - it stores nothing from /api/. A CPU gauge served from the cache lies about the
 *     state of a real server - which is worse than showing no number at all.
 *   - it does not go near file or backup downloads: those are multi-GB
 *     streaming responses, and going through the worker would only make them slower.
 *
 * It also shows the PUSH notifications (alerts the panel encrypted to this device; see
 * security/webpush.py). The text arrives inside the message, already in the owner's language:
 * the worker asks the panel for nothing, so an alert still shows with the session expired.
 */
const VERSION = '{{ version }}';
const CACHE = `gamepanel-${VERSION}`;
const OFFLINE = '{{ url_for("pwa.offline") }}';
const ICON = '{{ static_url("icons/icon-192.png") }}';

/* The app shell: what needs to be on the device for the "no
 * connection" page to open whole, with the same look as the rest of the panel. */
const CASCO = [
  OFFLINE,
{% for arquivo in precache %}  '{{ arquivo }}',
{% endfor %}];

/* Paths the worker does not touch, not even to pass them along. */
const FORA = ['/api/', '/files/download', '/backups/baixar', '/health'];

self.addEventListener('install', (ev) => {
  // No skipWaiting() on purpose: the new version stays WAITING, and whoever tells it
  // to take over is the person, through the "Update now" button. Swapping on its own reloads the
  // page - and this panel has a terminal screen with an open SSH session. Losing a
  // `nano` in the middle of an edit because the CSS changed is not an acceptable trade.
  ev.waitUntil(
    caches.open(CACHE)
      // allSettled, and not addAll: that one is all-or-nothing, and a file that was renamed
      // would take down the whole install, leaving the panel with no worker at all.
      .then((cache) => Promise.allSettled(CASCO.map((url) => cache.add(url)))),
  );
});

self.addEventListener('activate', (ev) => {
  ev.waitUntil(
    caches.keys()
      .then((nomes) => Promise.all(
        nomes.filter((n) => n.startsWith('gamepanel-') && n !== CACHE)
          .map((n) => caches.delete(n)),
      ))
      .then(() => self.clients.claim()),
  );
});

/* The page asks for the new version to take over now ("update" button). */
self.addEventListener('message', (ev) => {
  if (ev.data && ev.data.tipo === 'assumir') self.skipWaiting();
});

/* An alert from the panel. Every push MUST show a notification: a worker that receives one and
 * shows nothing gets its subscription revoked by Safari after a few times, and a broken message
 * still becomes a (generic) notification for that reason. */
self.addEventListener('push', (ev) => {
  let data = {};
  try {
    data = ev.data ? ev.data.json() : {};
  } catch {
    data = { body: ev.data ? ev.data.text() : '' };
  }
  const title = data.title || {{ _('app.name') | tojson }};
  ev.waitUntil(self.registration.showNotification(title, {
    body: data.body || '',
    icon: ICON,
    // Same tag = the newer alert replaces the older one instead of stacking up; renotify makes
    // the replacement ring again, otherwise a second "server down" would arrive in silence.
    tag: data.tag || undefined,
    renotify: Boolean(data.tag),
    data: { url: data.url || '/' },
  }));
});

/* Tapping the notification opens the panel: an already open window is reused, not duplicated. */
self.addEventListener('notificationclick', (ev) => {
  ev.notification.close();
  const target = new URL(ev.notification.data?.url || '/', self.location.origin).href;
  ev.waitUntil(
    self.clients.matchAll({ type: 'window', includeUncontrolled: true }).then((windows) => {
      const open = windows.find((w) => w.url.startsWith(self.location.origin));
      if (!open) return self.clients.openWindow(target);
      // navigate() only works on a window this worker controls; focusing is what matters.
      return open.focus().then((w) => w?.navigate?.(target)).catch(() => undefined);
    }),
  );
});

self.addEventListener('fetch', (ev) => {
  const req = ev.request;
  if (req.method !== 'GET') return;

  const url = new URL(req.url);
  if (url.origin !== self.location.origin) return;
  if (FORA.some((p) => url.pathname.includes(p))) return;

  if (url.pathname.startsWith('/static/')) {
    ev.respondWith(estaticoDoCache(req));
    return;
  }

  if (req.mode === 'navigate') {
    ev.respondWith(navegacao(req));
  }
});

/* Static: answers from the cache right away and fetches the new version in the background.
 *
 * It can be aggressive here because the cache name carries the version: at a deploy
 * switch the whole cache is discarded, so "old" here means at most
 * "from the same version". */
async function estaticoDoCache(req) {
  const cache = await caches.open(CACHE);
  const guardado = await cache.match(req, { ignoreSearch: true });

  const daRede = fetch(req).then((resp) => {
    if (resp && resp.ok) cache.put(req, resp.clone());
    return resp;
  }).catch(() => null);

  if (guardado) return guardado;
  const fresco = await daRede;
  // No network and no copy: return a real error, not a hanging promise.
  return fresco || new Response('', { status: 504, statusText: 'sem conexao' });
}

/* Navigation: always network. Without network, the "no connection" page. */
async function navegacao(req) {
  try {
    return await fetch(req);
  } catch {
    const cache = await caches.open(CACHE);
    const pagina = await cache.match(OFFLINE);
    return pagina || new Response(
      {{ ('<h1>' ~ _('offline.heading') ~ '</h1><p>' ~ _('offline.no_answer') ~ '</p>') | tojson }},
      { status: 503, headers: { 'Content-Type': 'text/html; charset=utf-8' } },
    );
  }
}
