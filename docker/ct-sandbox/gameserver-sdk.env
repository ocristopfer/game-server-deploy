# Game definition used ONLY by docker/ct-sandbox/gameserver.sh: the cheapest REAL SteamCMD install
# there is. App 1007 (Steamworks SDK Redist) downloads anonymously in seconds, so the sandbox
# exercises the real image end to end - SteamCMD as steam, PRE/POST_INSTALL, the supervisor, the
# panel's SSH access - without pulling gigabytes. The "game" is a script written by the
# post-install that stays up like a server and, on TERM, takes 2 s to "save" and exits 0: the
# sandbox checks that a stop waits for that save.
# A real game is `gameserver.sh --game <key>` (games/<key>.env).
GAME_KEY=sdkprobe
GAME_DISPLAY_NAME="Sandbox (Steamworks SDK)"
STEAM_APP_ID=1007
START_SCRIPT=sandbox-game.sh
START_ARGS="{PORT}"
GAME_PORT=27099
GAME_PORTS="27099/udp"
# Short, so the crash-loop check does not sit for the default 10 s.
RESTART_SEC=4
AUTO_UPDATE=0
POST_INSTALL_CMD='
set -e
cat > /opt/game/sandbox-game.sh <<"SH"
#!/bin/sh
trap "echo sandbox-game: TERM received, saving; sleep 2; echo sandbox-game: world saved; exit 0" TERM
echo "sandbox-game: up as $(id -un), port ${1:-0}"
while :; do sleep 5 & wait $!; done
SH
chmod 755 /opt/game/sandbox-game.sh
chown steam:steam /opt/game/sandbox-game.sh
'
