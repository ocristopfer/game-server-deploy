# Admin panel - production image (the Dockerfile next to it is the development
# one, which receives the code by bind mount).
#
# The build context is the repository ROOT, because the panel code goes into the image:
#   docker build -f docker/panel/Dockerfile.prod -t gamepanel .
#
# The package lives in /opt/gamepanel/gamepanel (WORKDIR is its parent) so that
# `import gamepanel` resolves without PYTHONPATH: it is the same mechanism that already
# made `app:app` work before the reorganization into src/ (see docs/architecture-proposal.md).
FROM debian:13-slim

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      python3 python3-flask gunicorn openssh-client ca-certificates tzdata \
 && rm -rf /var/lib/apt/lists/*

ENV GAMEPANEL_DB=/var/lib/gamepanel/panel.db \
    GAMEPANEL_SECRET_FILE=/etc/gamepanel/secret_key \
    GAMEPANEL_SSH_KEY=/etc/gamepanel/id_ed25519 \
    GAMEPANEL_KNOWN_HOSTS=/var/lib/gamepanel/known_hosts \
    GAMEPANEL_PORT=8080

COPY docker/panel/entrypoint.sh /usr/local/bin/panel-entrypoint
COPY src/gamepanel /opt/gamepanel/gamepanel
RUN chmod 0755 /usr/local/bin/panel-entrypoint

# The SSH key and the database live in volumes: recreating the container must not invalidate
# access to the game containers nor lose the registered servers.
VOLUME ["/etc/gamepanel", "/var/lib/gamepanel"]
WORKDIR /opt/gamepanel
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/panel-entrypoint"]
