# Copie para .env e ajuste. Usado no modo automatico:
#   .\deploy-game.ps1 -Game dragonwilds
# No modo interativo (-Interactive) esses valores viram apenas os defaults dos prompts.

# ===== Acesso ao Proxmox (root) =====
PROXMOX_HOST=192.168.1.254
# Preferencia e chave SSH. Sem chave autorizada no Proxmox, preencha a senha do root
# aqui (o .env esta no .gitignore). Rode uma vez com -InstallKey para autorizar sua
# chave publica la e parar de depender da senha.
# PROXMOX_PASSWORD=

# Endereco do CT do painel. Com ele (ou com ADMIN_IP_CIDR fixo), o deploy manda o
# codigo direto para o container em vez de passar pelo Proxmox.
# ADMIN_HOST=192.168.2.10

# ===== Container LXC (valores comuns a todos os jogos) =====
# CTID e IP_CIDR aqui sao o FALLBACK: valem para o deploy generico (-AppId) e para
# jogos que nao tem bloco proprio abaixo. Cada jogo com bloco proprio ignora estes.
CTID=219
# HOSTNAME_OVERRIDE=         # vazio = usa o nome do jogo (GAME_KEY)
STORAGE=vm-pool              # storage do rootfs
TEMPLATE_STORAGE=vm-pool-data
BRIDGE=vmbr1
IP_CIDR=192.168.2.29/24      # ou "dhcp"
GATEWAY=192.168.2.1          # ignorado quando IP_CIDR=dhcp
CT_PASSWORD=changeme
TZ=America/Sao_Paulo

# ===== Um container por jogo =====
# Qualquer chave do bloco acima pode ser especializada por jogo com o sufixo
# _<GAME_KEY em maiusculas>: CTID_PALWORLD, IP_CIDR_PALWORLD, MEMORY_PALWORLD...
# O deploy recusa rodar se o CTID/IP resolvido ja for de outro jogo ou do painel.
#
#   CTID  | jogo         | IP
#   ------+--------------+---------------
#   209   | gamepanel    | 192.168.2.19   (painel, ADMIN_CTID abaixo)
#   210   | dragonwilds  | 192.168.2.20
#   211   | palworld     | 192.168.2.21
#   212   | satisfactory | 192.168.2.22
#   213   | enshrouded   | 192.168.2.23
#   214   | dayz         | 192.168.2.24

CTID_DRAGONWILDS=210
IP_CIDR_DRAGONWILDS=192.168.2.20/24

CTID_PALWORLD=211
IP_CIDR_PALWORLD=192.168.2.21/24

CTID_SATISFACTORY=212
IP_CIDR_SATISFACTORY=192.168.2.22/24

CTID_ENSHROUDED=213
IP_CIDR_ENSHROUDED=192.168.2.23/24

CTID_DAYZ=214
IP_CIDR_DAYZ=192.168.2.24/24

# ===== Conta Steam (so para jogos com STEAM_ANONYMOUS=0, hoje o dayz) =====
# O depot do servidor de DayZ nao sai por login anonimo: precisa de uma conta que
# POSSUA o jogo. Use uma conta dedicada, nao a sua principal.
# STEAM_USER=
# STEAM_PASS=
# Codigo do Steam Guard: expira em segundos, entao o normal e passar na linha de
# comando na hora do deploy (.\deploy-game.ps1 -Game dayz -SteamGuardCode 12345)
# em vez de deixar aqui. So e pedido no primeiro login de cada container.
# STEAM_GUARD_CODE=

# ===== Recursos (vazio = usa o recomendado do jogo) =====
MEMORY=
CORES=
ROOTFS_SIZE_GB=
SWAP=512

# ===== Update automatico =====
# 1 = checa updates no horario abaixo e so reinicia o servidor se houver versao nova
AUTO_UPDATE=1
# Formato OnCalendar do systemd (padrao: todo dia 06:00)
UPDATE_SCHEDULE=*-*-* 06:00:00

# Recriar o CT do zero se ja existir (1 = destroi e recria!)
RECREATE_CT=0

# ========================================================================
# Deploy em Docker (deploy-docker.ps1) - alternativa ao LXC do Proxmox.
#
#   .\deploy-docker.ps1 -Panel            # painel em http://localhost:8080
#   .\deploy-docker.ps1 -Game palworld    # jogo + cadastro automatico no painel
#
# Reaproveita o que ja esta neste arquivo: MEMORY/CORES (e as versoes por jogo,
# MEMORY_PALWORLD...), TZ, AUTO_UPDATE, ADMIN_PORT/ADMIN_USER/ADMIN_PASSWORD e a
# definicao de cada jogo em games/<jogo>.env. CTID/IP/STORAGE sao so do Proxmox.
# ========================================================================

# Docker de destino. Vazio = o Docker desta maquina.
# Remoto: ssh://root@192.168.1.50 (a chave SSH ja tem que estar autorizada la)
# DOCKER_HOST=

# Porta SSH publicada no host para um container de jogo. Normalmente NAO precisa:
# o painel fala com os jogos pela rede interna 'games'. Aceita sufixo por jogo.
# SSH_PORT_PALWORLD=2211

# Horario da checagem diaria de update dentro do container (HH:MM).
UPDATE_TIME=06:00
# 1 = revalida os arquivos do jogo no SteamCMD a cada start do container (mais lento).
UPDATE_ON_START=0

# Chave publica do painel administrativo. Se preenchida, o deploy do jogo ja instala o
# sshd no CT e autoriza essa chave — o container nasce pronto para o painel.
# Pegue em: resumo do deploy-admin.ps1, ou na tela "Acesso SSH" do painel.
# PANEL_PUBKEY=ssh-ed25519 AAAA... gamepanel@gamepanel

# ========================================================================
# Painel administrativo (deploy-admin.ps1) — container separado, com tela
# web para cadastrar servidores, dar start/stop/restart, atualizar e rodar
# comandos. Ele acessa os containers de jogo por SSH; nao acessa o Proxmox.
# ========================================================================
ADMIN_CTID=200
ADMIN_HOSTNAME=gamepanel
ADMIN_IP_CIDR=192.168.2.10/24   # ou "dhcp"
ADMIN_GATEWAY=192.168.2.1       # vazio = usa GATEWAY acima
ADMIN_MEMORY=512
ADMIN_CORES=1
ADMIN_DISK_GB=4
ADMIN_SWAP=256

# Acesso ao painel (http://<ip-do-ct>:<porta>)
ADMIN_PORT=8080
ADMIN_USER=admin
# Vazio = o deploy gera uma senha aleatoria e a mostra no resumo final.
# Preencher aqui e rodar o deploy de novo tambem serve para RESETAR a senha.
ADMIN_PASSWORD=

# Console web + terminal interativo: permitem rodar comandos arbitrarios como root
# DENTRO dos containers de jogo (nunca no host). 0 desabilita as duas telas.
ADMIN_ALLOW_SHELL=1
# Quantos terminais podem ficar abertos ao mesmo tempo e em quantos segundos sem uso a
# sessao e derrubada (cada sessao segura um processo ssh no painel).
ADMIN_TERM_MAX=4
ADMIN_TERM_IDLE=900

# Medidores de CPU/memoria/disco/rede: por quantos segundos a leitura fica em cache
# (cada leitura e uma ida de SSH de ~1s no container).
ADMIN_METRICS_TTL=4

# Contagem de jogadores (consulta A2S da Steam na porta de query de cada servidor,
# configurada no cadastro). Quanto esperar pela resposta e por quanto tempo guardar.
ADMIN_QUERY_TIMEOUT=3
ADMIN_PLAYERS_TTL=5

# Editor de arquivos de configuracao dos jogos (le e grava .ini/.cfg por SSH).
ADMIN_ALLOW_FILES=1
ADMIN_FILE_MAX_KB=4096          # tamanho maximo para EDITAR um arquivo
ADMIN_FILE_PREVIEW_KB=256       # acima do limite acima, quanto do fim mostrar (so leitura)
ADMIN_FILE_DOWNLOAD_MAX_MB=2048 # teto do download (vai em streaming); 0 = sem limite
ADMIN_FILE_DEFAULT=/opt/game    # pasta inicial quando o servidor nao define a dele
ADMIN_FILE_ROOTS=/              # limite o navegador de arquivos: ex. "/opt,/etc"

# CTIDs de jogo ja existentes que devem receber o sshd + a chave do painel durante o
# deploy. Sem isso, autorize manualmente pela tela "Acesso SSH".
ADMIN_AUTHORIZE_CTIDS=210,211,212,213,214

RECREATE_ADMIN_CT=0
