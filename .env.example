# Copy to .env and adjust. Used in automatic mode:
#   .\deploy-game.ps1 -Game dragonwilds
# In interactive mode (-Interactive) these values only become the defaults of the prompts.

# ===== Proxmox access (root) =====
PROXMOX_HOST=10.20.0.2
# An SSH key is preferred. Without an authorized key on Proxmox, fill in the root password
# here (.env is in .gitignore). Run once with -InstallKey to authorize your public key
# there and stop depending on the password.
# PROXMOX_PASSWORD=

# Address of the panel CT. With it (or with a fixed ADMIN_IP_CIDR), the deploy sends the
# code straight to the container instead of going through Proxmox.
# ADMIN_HOST=10.20.1.10

# ===== LXC container (values shared by all games) =====
# CTID and IP_CIDR here are the FALLBACK: they apply to the generic deploy (-AppId) and to
# games without their own block below. Each game with its own block ignores these.
CTID=219
# HOSTNAME_OVERRIDE=         # empty = use the game name (GAME_KEY)
STORAGE=local-lvm              # rootfs storage
TEMPLATE_STORAGE=local
BRIDGE=vmbr0
IP_CIDR=10.20.1.29/24      # or "dhcp"
GATEWAY=10.20.1.1          # ignored when IP_CIDR=dhcp
CT_PASSWORD=               # empty = root without a password (only pct enter / SSH key)
TZ=America/Sao_Paulo

# ===== One container per game =====
# Any key from the block above can be specialized per game with the suffix
# _<GAME_KEY in uppercase>: CTID_PALWORLD, IP_CIDR_PALWORLD, MEMORY_PALWORLD...
# The deploy refuses to run if the resolved CTID/IP already belongs to another game or the panel.
#
#   CTID  | game         | IP
#   ------+--------------+---------------
#   209   | gamepanel    | 10.20.1.19   (panel, ADMIN_CTID below)
#   210   | dragonwilds  | 10.20.1.20
#   211   | palworld     | 10.20.1.21
#   212   | satisfactory | 10.20.1.22
#   213   | enshrouded   | 10.20.1.23
#   214   | dayz         | 10.20.1.24
#   215   | icarus       | 10.20.1.25

CTID_DRAGONWILDS=210
IP_CIDR_DRAGONWILDS=10.20.1.20/24

CTID_PALWORLD=211
IP_CIDR_PALWORLD=10.20.1.21/24

CTID_SATISFACTORY=212
IP_CIDR_SATISFACTORY=10.20.1.22/24

CTID_ENSHROUDED=213
IP_CIDR_ENSHROUDED=10.20.1.23/24

CTID_DAYZ=214
IP_CIDR_DAYZ=10.20.1.24/24

CTID_ICARUS=215
IP_CIDR_ICARUS=10.20.1.25/24

# ===== Steam account (only for games with STEAM_ANONYMOUS=0, today dayz) =====
# The DayZ server depot cannot be downloaded with an anonymous login: it needs an account
# that OWNS the game. Use a dedicated account, not your main one.
# STEAM_USER=
# STEAM_PASS=
# Steam Guard code: it expires within seconds, so the usual way is to pass it on the
# command line at deploy time (.\deploy-game.ps1 -Game dayz -SteamGuardCode 12345)
# instead of leaving it here. It is only asked for on the first login of each container.
# STEAM_GUARD_CODE=

# ===== Resources (empty = use the game's recommended values) =====
MEMORY=
CORES=
ROOTFS_SIZE_GB=
SWAP=512

# ===== Automatic update =====
# 1 = check for updates at the time below and only restart the server if there is a new version
AUTO_UPDATE=1
# systemd OnCalendar format (default: every day at 06:00)
UPDATE_SCHEDULE="*-*-* 06:00:00"

# Recreate the CT from scratch if it already exists (1 = destroys and recreates it!)
RECREATE_CT=0

# ========================================================================
# Docker deploy (deploy-docker.ps1) - alternative to the Proxmox LXC.
#
#   .\deploy-docker.ps1 -Panel            # panel at http://localhost:8080
#   .\deploy-docker.ps1 -Game palworld    # game + automatic registration in the panel
#
# Reuses what is already in this file: MEMORY/CORES (and the per-game versions,
# MEMORY_PALWORLD...), TZ, AUTO_UPDATE, ADMIN_PORT/ADMIN_USER/ADMIN_PASSWORD and the
# definition of each game in games/<game>.env. CTID/IP/STORAGE are Proxmox-only.
# ========================================================================

# Target Docker. Empty = the Docker on this machine.
# Remote: ssh://root@10.20.0.50 (the SSH key must already be authorized there)
# DOCKER_HOST=

# SSH port published on the host for a game container. Usually NOT needed:
# the panel talks to the games over the internal 'games' network. Accepts a per-game suffix.
# SSH_PORT_PALWORLD=2211

# Time of the daily update check inside the container (HH:MM).
UPDATE_TIME=06:00
# 1 = revalidate the game files with SteamCMD on every container start (slower).
UPDATE_ON_START=0

# Public key of the admin panel: with it the game deploy installs sshd in the CT and
# authorizes the panel - the container is born ready for the panel screens.
# Usually you do NOT need to fill it in: deploy-game.ps1 reads the key from the panel itself
# (ADMIN_CTID, or ADMIN_HOST/ADMIN_IP_CIDR). Fill it in to pin a specific key.
# Get it from the deploy-admin.ps1 summary, or from the panel's "Acesso SSH" screen.
# PANEL_PUBKEY=ssh-ed25519 AAAA... gamepanel@gamepanel

# ========================================================================
# Admin panel (deploy-admin.ps1) - a separate container with a web UI to
# register servers, start/stop/restart them, update them and run commands.
# It reaches the game containers over SSH; it does not access Proxmox.
# ========================================================================
ADMIN_CTID=200
ADMIN_HOSTNAME=gamepanel
ADMIN_IP_CIDR=10.20.1.10/24   # or "dhcp"
ADMIN_GATEWAY=10.20.1.1       # empty = use GATEWAY above
ADMIN_MEMORY=512
ADMIN_CORES=1
ADMIN_DISK_GB=4
ADMIN_SWAP=256

# Panel access (http://<ct-ip>:<port>)
ADMIN_PORT=8080
# Firewall inside the panel CT: who can reach the web UI and SSH (default: the whole local network).
# Separate several with spaces or commas. Outside access only through a tunnel/proxy from inside the LAN.
# ADMIN_FIREWALL_SOURCES=192.168.0.0/16
# 0 = no CT (panel, broker, games) gets the internal firewall on the next deploys.
# CT_FIREWALL=1
ADMIN_USER=admin
# Empty = the deploy generates a random password and shows it in the final summary.
# Filling it in here and running the deploy again also RESETS the password.
ADMIN_PASSWORD=

# Web console + interactive terminal: they allow running arbitrary commands as root
# INSIDE the game containers (never on the host). 0 disables both screens.
ADMIN_ALLOW_SHELL=1
# How many terminals can be open at the same time, and after how many idle seconds a
# session is dropped (each session holds an ssh process on the panel).
ADMIN_TERM_MAX=4
ADMIN_TERM_IDLE=900

# CPU/memory/disk/network gauges: for how many seconds a reading stays cached
# (each reading is an SSH round trip of ~1s to the container).
ADMIN_METRICS_TTL=4

# Player count (Steam A2S query on each server's query port, set when the server is
# registered). How long to wait for the answer and how long to keep it.
ADMIN_QUERY_TIMEOUT=3
ADMIN_PLAYERS_TTL=5

# Second factor at login (2FA, authenticator app). Each person enables their own under Account.
# With 1, anyone who has not enabled it only reaches the enrollment screen: turn it on AFTER every
# admin has enabled theirs.
# Lost the phone and the recovery codes? On the panel CT:
#   python3 /opt/gamepanel/app.py --reset-2fa USERNAME    (or "Disable 2FA" on the Users screen)
ADMIN_REQUIRE_2FA=0

# Sign in with the phone's biometrics (passkey/WebAuthn). The browser only allows it over https
# with a domain NAME (an IP does not work), so this is the panel's public address, without a
# trailing slash: https://panel.yourdomain.com. Empty = disabled. Changing the address later
# invalidates the passkeys already registered (the device key is bound to the domain).
ADMIN_WEBAUTHN_ORIGIN=

# UI language: pt (default) or en. Applies to whoever has not picked their own under Account and
# to the login screen; each person can change theirs later. The alert sent to the webhook and the
# text recorded in the History ALWAYS follow this one: the channel and the list are read by
# several people, and the same message written in three languages would be worse than in one.
ADMIN_LANG=pt

# Editor for the games' config files (reads and writes .ini/.cfg over SSH).
ADMIN_ALLOW_FILES=1
ADMIN_FILE_MAX_KB=4096          # maximum size to EDIT a file
ADMIN_FILE_PREVIEW_KB=256       # above that limit, how much of the end to show (read-only)
ADMIN_FILE_DOWNLOAD_MAX_MB=2048 # download cap (streamed); 0 = no limit
ADMIN_FILE_DEFAULT=/opt/game    # starting folder when the server does not set its own
ADMIN_FILE_ROOTS=/opt/game,/home/steam  # where the file browser can go ("/" = everywhere)

RECREATE_ADMIN_CT=0

# ========================================================================
# ===== Broker (creates game instances on Proxmox and opens ports on OPNsense) =====
# ========================================================================
# .\deploy-broker.ps1   (Proxmox/OPNsense tokens live in broker.secrets.env, OUTSIDE git)
# Address scheme: the CTID is "3" + the last two digits of the IP (CTID = 200 + last number),
# so the IP already tells the CT, and everything in 300-399 belongs to this system:
#   panel .100 (CT 300)  |  broker .101 (CT 301)  |  games created by the broker .102-.199 (CT 302-399)
# Older servers (made by hand or with deploy-game.ps1) stay where they are (CTs 2xx). Do NOT let the
# OPNsense DHCP hand out .100-.199: a device would grab the IP of a CT that does not exist yet.
# The broker's CT. OUTSIDE the game CTID/IP range below and outside the "games" pool.
BROKER_CTID=301
BROKER_HOSTNAME=gamebroker
BROKER_IP_CIDR=10.20.1.101/24    # FIXED IP: the certificate and the firewall depend on it
# BROKER_GATEWAY=                  # empty = GATEWAY above
BROKER_PORT=8443
# Range of the CTs it creates. CTID = BROKER_CTID_BASE + last number of the IP (.102 -> 302); with
# BROKER_CTID_BASE=0 the CTID is picked separately, between BROKER_CTID_INICIO and BROKER_CTID_FIM.
BROKER_IP_PREFIX=10.20.1
BROKER_IP_INICIO=102
BROKER_IP_FIM=199
BROKER_CTID_BASE=200
# BROKER_CTID_INICIO=300
# BROKER_CTID_FIM=399
# Port range reserved for the broker, for games that accept a different port (PORTS_SHIFTABLE=1). It
# stays away from the games' default ports and below Linux's ephemeral ports (32768+). The broker
# checks OPNsense first.
BROKER_PORT_INICIO=31000
BROKER_PORT_FIM=31999
# Quotas: the ceiling on the damage if the panel is compromised.
BROKER_MAX_INSTANCIAS=8
# Counts EVERY attempt in the last hour, including the ones that failed or were cancelled.
BROKER_MAX_CREATIONS_PER_HOUR=10
# Who may talk to the broker (default: the panel IP, derived from ADMIN_HOST/ADMIN_IP_CIDR).
# BROKER_ALLOW_IPS=10.20.1.10
RECREATE_BROKER_CT=0
