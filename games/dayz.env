# DayZ - definicao do jogo
# Fonte: Steam app 223350 (DayZ Server, build nativo Linux)
#
# ATENCAO: este e o unico jogo daqui que NAO baixa com login anonimo. O depot do
# servidor esta atras de uma conta Steam que POSSUA o DayZ (app 221100). Preencha
# STEAM_USER / STEAM_PASS no .env (nunca aqui - este arquivo vai para o git):
#
#   .\deploy-game.ps1 -Game dayz -SteamGuardCode 12345
#
# O codigo do Steam Guard so e preciso no primeiro login de cada container; depois
# o SteamCMD guarda o token e o update automatico roda sozinho.

GAME_KEY=dayz
GAME_DISPLAY_NAME="DayZ"
STEAM_APP_ID=223350

# 0 = o SteamCMD precisa logar com conta (o deploy para antes se faltar credencial)
STEAM_ANONYMOUS=0

# Binario nativo Linux ({PORT} e substituido pela porta final).
# -profiles guarda logs/estatisticas; -BEpath e a pasta do BattlEye; -dologs/-adminlog/
# -netlog povoam o log que o painel le para contar jogadores.
START_SCRIPT=DayZServer
START_ARGS="-config=serverDZ.cfg -port={PORT} -profiles=profiles -BEpath=battleye -dologs -adminlog -netlog -freezecheck -limitFPS=60"

# Portas (formato: porta/protocolo, separadas por espaco)
GAME_PORT=2302
GAME_PORTS="2302/udp 2303/udp 2304/udp 27016/udp"
PORT_NOTES="2302/UDP e a porta do jogo; 2303 e 2304/UDP sao usadas pela engine (Steam) e 27016/UDP e a query (steamQueryPort no serverDZ.cfg) - sem ela o servidor nao aparece no navegador do cliente. Tudo UDP, nada de TCP. No cadastro do painel use 27016 como porta de consulta: o DayZ publica A2S normalmente."

# Recursos recomendados (usados se nao definidos no .env)
# Vanilla com ~20 jogadores fica perto de 4GB; mods e mapas maiores passam disso.
RECOMMENDED_MEMORY=8192
RECOMMENDED_CORES=4
RECOMMENDED_DISK_GB=24

# Pos-instalacao:
# 1) o servidor usa a Steam API para se registrar (precisa do steamclient.so em ~/.steam)
# 2) as pastas profiles/ e battleye/ tem que existir antes do primeiro start
# 3) o serverDZ.cfg de exemplo vem sem steamQueryPort - semeamos um completo
POST_INSTALL_CMD='
set -e
install -d -o steam -g steam /home/steam/.steam/sdk64
ln -sf /opt/steamcmd/linux64/steamclient.so /home/steam/.steam/sdk64/steamclient.so
chown -h steam:steam /home/steam/.steam/sdk64/steamclient.so

install -d -o steam -g steam /opt/game/profiles /opt/game/battleye

if [ ! -s /opt/game/serverDZ.cfg ]; then
  cat > /opt/game/serverDZ.cfg <<"CFG"
hostname = "Servidor DayZ";        // nome que aparece no navegador de servidores
password = "";                     // senha para entrar (vazio = servidor aberto)
passwordAdmin = "";                // senha do RCON/admin - TROQUE antes de expor
maxPlayers = 20;

verifySignatures = 2;              // 2 = so aceita mods assinados (deixe assim)
forceSameBuild = 1;                // cliente precisa estar na mesma versao do servidor

disableVoN = 0;                    // 0 = voz habilitada
vonCodecQuality = 20;
disable3rdPerson = 0;              // 1 = servidor apenas em primeira pessoa
disableCrosshair = 0;

serverTime = "SystemTime";         // hora inicial do mundo
serverTimeAcceleration = 12;       // 12 = um dia do jogo a cada 2h reais
serverNightTimeAcceleration = 1;
serverTimePersistent = 0;

guaranteedUpdates = 1;
loginQueueConcurrentPlayers = 5;
loginQueueMaxPlayers = 500;

instanceId = 1;                    // define a pasta storage_<id> da persistencia
storageAutoFix = 1;                // conserta a persistencia corrompida no start

steamQueryPort = 27016;            // porta de consulta - precisa bater com GAME_PORTS

class Missions
{
    class DayZ
    {
        template = "dayzOffline.chernarusplus";   // troque para enoch (Livonia) se quiser
    };
};
CFG
  chown steam:steam /opt/game/serverDZ.cfg
  echo "serverDZ.cfg criado - ajuste hostname e passwordAdmin"
else
  echo "serverDZ.cfg ja existe, mantido"
fi
'

# Cadastro automatico no painel (usado pelo deploy-docker.ps1)
CONFIG_PATH=/opt/game
CONFIG_FILES=/opt/game/serverDZ.cfg
QUERY_PORT=27016
# A consulta A2S conta (ela fala com o jogo agora); os NOMES vem do log de administracao
# (.ADM), porque o DayZ devolve a lista da consulta em branco. O -adminlog do START_ARGS
# acima liga esse log, e o painel o le por LOG_PATH. Se a consulta nao responder, o log
# assume a contagem tambem.
PLAYER_SOURCE=a2s

# O .ADM e por sessao (o jogo abre um novo a cada start), por isso o '*': o painel pega
# sempre o mais recente. Formato das linhas (documentacao da Bohemia):
#   16:21:58 | Player "Survivor" is connected (id=...)
#   16:23:10 | Player "Survivor"(id=...) has been disconnected
LOG_PATH=/opt/game/profiles/*.ADM
JOIN_RE='Player "(?P<name>[^"]+)" is connected'
LEAVE_RE='Player "(?P<name>[^"]+)"\(id=[^)]*\) has been disconnected'

# Pastas que a tela Backups do painel guarda no .tar.gz (separadas por virgula).
# E o SAVE do jogo, nao a raiz: /opt/game inteiro leva os binarios que o SteamCMD
# rebaixa de graca. Caminho que ainda nao existe e ignorado com aviso, entao pode
# apontar a pasta que so nasce no primeiro start.
BACKUP_PATHS=/opt/game/mpmissions/dayzOffline.chernarusplus/storage_1,/opt/game/profiles

# Dicas pos-instalacao
CONFIG_HINT="/opt/game/serverDZ.cfg - ajuste hostname, password (entrada), passwordAdmin, maxPlayers e o template da missao (dayzOffline.chernarusplus ou dayzOffline.enoch). Pare o servidor antes de editar (systemctl stop dayz)."
SAVE_HINT="/opt/game/mpmissions/dayzOffline.chernarusplus/storage_1/ (persistencia; o numero segue o instanceId do serverDZ.cfg). Logs e stats em /opt/game/profiles/"
