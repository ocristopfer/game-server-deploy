# Template for adding a new game.
# Copy to games/<name>.env and fill it in.

# Short identifier (used as the CT hostname and as the systemd service name)
GAME_KEY=meujogo
GAME_DISPLAY_NAME="Meu Jogo"

# Steam App ID of the DEDICATED SERVER (not the game's!)
# Look it up at: https://steamdb.info or on the game's page
STEAM_APP_ID=000000

# Platform forced in SteamCMD. Leave empty for the native Linux build.
# Use "windows" when the game does not publish a Linux server (runs via Wine) - in that
# case install Wine in PRE_INSTALL_CMD. Ready-made example: games/enshrouded.env
STEAM_PLATFORM=

# 1 (default) = SteamCMD downloads with anonymous login, like almost every dedicated server.
# 0 = the depot requires a Steam account that owns the game (e.g. DayZ). In that case the
# deploy reads STEAM_USER/STEAM_PASS from .env - never store credentials here, this
# file goes into git. Ready-made example: games/dayz.env
STEAM_ANONYMOUS=1

# Start script/binary inside /opt/game.
# Leave empty for the script to try to detect it automatically (*.sh at the root).
START_SCRIPT=
# Start arguments. {PORT} is replaced by the game port.
START_ARGS=""

# Ports the game uses (format: port/protocol, separated by spaces)
GAME_PORT=27015
GAME_PORTS="27015/udp"
# 1 = the broker may pick the ports from its own range (several instances of the same game).
# Only valid if START_ARGS receives {PORT} (and {QUERY_PORT}, if there is a QUERY_PORT) and the game
# only has those two ports; otherwise the game is rejected by the catalog. 0/absent = always the default ports.
# PORTS_SHIFTABLE=1
PORT_NOTES=""

# Recommended resources (used when the .env does not define MEMORY/CORES/ROOTFS_SIZE_GB)
RECOMMENDED_MEMORY=4096
RECOMMENDED_CORES=2
RECOMMENDED_DISK_GB=20

# Extra commands run INSIDE the CT BEFORE the game download.
# Use for dependencies the download/execution requires (e.g. installing Wine).
# Must be idempotent - runs on every deploy.
PRE_INSTALL_CMD=''

# Extra commands run INSIDE the CT right after the game is installed
# (before detecting START_SCRIPT and creating the service). Use for symlinks,
# initial config, or even to generate the start script itself.
# Must be idempotent - runs on every deploy.
POST_INSTALL_CMD=''

# ----- Automatic registration in the panel (used by deploy-docker.ps1) -----
# Folder the panel's "Files" screen opens.
CONFIG_PATH=
# Files the "Config" screen opens as a form (field by field), separated by
# commas. Understood formats: .ini/.conf/.properties, .json and serverDZ.cfg.
CONFIG_FILES=
# Steam A2S query port (0 = the game does not publish a query).
QUERY_PORT=0
# How the panel counts players: a2s (query on the port above), http (the game's own
# API, the only one that returns the names) or log. The http source needs a URL and password, which
# only exist after the first start - configure it through the panel wizard
# (Configure counting > HTTP API), not here.
PLAYER_SOURCE=log

# Counting by log: patterns the panel uses to know who joined and left.
# With (?P<name>...) on BOTH sides the panel says exactly who is online;
# only on join, it gets the count right and shows the names as an approximation.
# Empty LOG_PATH = reads the service output (journalctl).
LOG_PATH=
JOIN_RE=
LEAVE_RE=

# Folders the panel's Backups screen stores in the .tar.gz (comma separated).
# It is the game SAVE, not the root: the whole /opt/game carries the binaries that SteamCMD
# downloads again for free. A path that does not exist yet is skipped with a warning, so it may
# point to the folder that only appears on the first start.
BACKUP_PATHS=

CONFIG_HINT=""
SAVE_HINT=""
