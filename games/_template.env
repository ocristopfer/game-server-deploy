# Template para adicionar um novo jogo.
# Copie para games/<nome>.env e preencha.

# Identificador curto (usado como hostname do CT e nome do servico systemd)
GAME_KEY=meujogo
GAME_DISPLAY_NAME="Meu Jogo"

# App ID do SERVIDOR DEDICADO na Steam (nao o do jogo!)
# Consulte: https://steamdb.info ou a pagina do jogo
STEAM_APP_ID=000000

# Plataforma forcada no SteamCMD. Deixe vazio para o build nativo Linux.
# Use "windows" quando o jogo nao publica servidor Linux (roda via Wine) - nesse
# caso instale o Wine no PRE_INSTALL_CMD. Exemplo pronto: games/enshrouded.env
STEAM_PLATFORM=

# 1 (padrao) = o SteamCMD baixa com login anonimo, como quase todo servidor dedicado.
# 0 = o depot exige uma conta Steam que possua o jogo (ex.: DayZ). Nesse caso o
# deploy le STEAM_USER/STEAM_PASS do .env - nunca guarde credencial aqui, este
# arquivo vai para o git. Exemplo pronto: games/dayz.env
STEAM_ANONYMOUS=1

# Script/binario de start dentro de /opt/game.
# Deixe vazio para o script tentar detectar automaticamente (*.sh na raiz).
START_SCRIPT=
# Argumentos de start. {PORT} e substituido pela porta do jogo.
START_ARGS=""

# Portas que o jogo usa (formato: porta/protocolo, separadas por espaco)
GAME_PORT=27015
GAME_PORTS="27015/udp"
PORT_NOTES=""

# Recursos recomendados (usados quando o .env nao define MEMORY/CORES/ROOTFS_SIZE_GB)
RECOMMENDED_MEMORY=4096
RECOMMENDED_CORES=2
RECOMMENDED_DISK_GB=20

# Comandos extras rodados DENTRO do CT ANTES do download do jogo.
# Use para dependencias que o download/execucao exige (ex.: instalar Wine).
# Precisa ser idempotente - roda a cada deploy.
PRE_INSTALL_CMD=''

# Comandos extras rodados DENTRO do CT logo apos a instalacao do jogo
# (antes de detectar o START_SCRIPT e criar o servico). Use para symlinks,
# config inicial, ou ate para gerar o proprio script de start.
# Precisa ser idempotente - roda a cada deploy.
POST_INSTALL_CMD=''

# ----- Cadastro automatico no painel (usado pelo deploy-docker.ps1) -----
# Pasta onde a tela "Arquivos" do painel abre.
CONFIG_PATH=
# Arquivos que a tela "Config" abre como formulario (campo a campo), separados por
# virgula. Formatos entendidos: .ini/.conf/.properties, .json e o serverDZ.cfg.
CONFIG_FILES=
# Porta de consulta A2S da Steam (0 = o jogo nao publica consulta).
QUERY_PORT=0
# Como o painel conta jogadores: a2s (consulta na porta acima), http (API do proprio
# jogo, a unica que devolve os nomes) ou log. A fonte http precisa de URL e senha, que
# so existem depois do primeiro start - configure pelo assistente do painel
# (Configurar contagem > API HTTP), nao aqui.
PLAYER_SOURCE=log

# Pastas que a tela Backups do painel guarda no .tar.gz (separadas por virgula).
# E o SAVE do jogo, nao a raiz: /opt/game inteiro leva os binarios que o SteamCMD
# rebaixa de graca. Caminho que ainda nao existe e ignorado com aviso, entao pode
# apontar a pasta que so nasce no primeiro start.
BACKUP_PATHS=

CONFIG_HINT=""
SAVE_HINT=""
