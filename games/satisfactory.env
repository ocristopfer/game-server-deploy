# Satisfactory - game definition
# Source: Steam app 1690800 (Satisfactory Dedicated Server, native Linux build)

GAME_KEY=satisfactory
GAME_DISPLAY_NAME="Satisfactory"
STEAM_APP_ID=1690800

# Startup script inside the game folder ({PORT} is replaced by the final port)
# -log sends the Unreal log to stdout (journald keeps it, the panel reads it)
# -unattended avoids any prompt/window in an environment with no interface
START_SCRIPT=FactoryServer.sh
START_ARGS="-Port={PORT} -ReliablePort={EXTRA_PORT} -log -unattended"

# Ports (format: port/protocol, separated by spaces)
GAME_PORT=7787
GAME_PORTS="7787/udp 7787/tcp 8888/tcp"
# Third port the game accepts as an argument ({EXTRA_PORT} in START_ARGS): the reliable
# messaging one, TCP. The game default is 8888; the broker picks another when there are several instances.
EXTRA_PORT=8888
# 0 = the game's default ports, always (decision: curated games do not use the broker's assigned
# range; a second instance of the same game is rejected because the port is taken). The {PORT} in
# START_ARGS stays: with a fixed port it receives the default number. 1 = broker range.
PORTS_SHIFTABLE=0
PORT_NOTES="O servidor usa uma porta principal para o jogo e para a API: UDP (trafego do jogo) e TCP (API de gerenciamento HTTPS usada pelo cliente para adotar/configurar o servidor). O padrao do jogo e 7777, mas aqui ele roda na 7787: o Dragonwilds foi configurado antes e ficou com a faixa 7777-7779, e no NAT uma porta externa so pode apontar para um destino. No cliente, adicione o servidor como IP:7787 - a mesma porta serve o jogo e a API. Abra os dois protocolos no roteador, e tambem a 8888/TCP (mensagens confiaveis, -ReliablePort): sem ela quem conecta de fora tem problemas. As portas antigas 15000/15777 nao sao mais usadas. O jogo nao publica query A2S da Steam. A contagem no painel sai do log; quem tiver um token de admin da API pode trocar pela fonte 'API HTTP' (POST https://127.0.0.1:7777/api/v1 com corpo {\"function\":\"QueryServerState\"} e bearer:<token>), que devolve numConnectedPlayers."

# Recommended resources (used if not defined in .env)
# Coffee Stain recommends 12GB of RAM; big factories go beyond that, hence 16GB.
RECOMMENDED_MEMORY=16384
RECOMMENDED_CORES=4
RECOMMENDED_DISK_GB=32

# Post-install:
# FactoryServer.sh looks for steamclient.so in ~/.steam/sdk64; without the symlink
# the server starts but does not register with Steam (the client cannot find the server).
POST_INSTALL_CMD='
install -d -o steam -g steam /home/steam/.steam/sdk64
ln -sf /opt/steamcmd/linux64/steamclient.so /home/steam/.steam/sdk64/steamclient.so
chown -h steam:steam /home/steam/.steam/sdk64/steamclient.so

install -d -o steam -g steam /home/steam/.config/Epic/FactoryGame/Saved/SaveGames/server
'

# Automatic registration in the panel (used by deploy-docker.ps1)
# The .ini files only appear after the first start (and after the server is claimed in the game).
CONFIG_PATH=/home/steam/.config/Epic/FactoryGame/Saved/Config/LinuxServer
CONFIG_FILES=/home/steam/.config/Epic/FactoryGame/Saved/Config/LinuxServer/ServerSettings.ini,/home/steam/.config/Epic/FactoryGame/Saved/Config/LinuxServer/GameUserSettings.ini
QUERY_PORT=0
PLAYER_SOURCE=log

# Counting by log: patterns the panel uses to know who joined and left.
# With (?P<name>...) on BOTH sides the panel says exactly who is online;
# only on join, it gets the count right and shows the names as an approximation.
# Empty LOG_PATH = reads the service output (journalctl).
LOG_PATH=
JOIN_RE='LogNet: Join succeeded: (?P<name>.+)'
LEAVE_RE='LogNet: UNetConnection::Close:'

# Folders the panel's Backups screen stores in the .tar.gz (comma separated).
# It is the game SAVE, not the root: the whole /opt/game carries the binaries that SteamCMD
# downloads again for free. A path that does not exist yet is skipped with a warning, so it may
# point to the folder that only appears on the first start.
BACKUP_PATHS=/home/steam/.config/Epic/FactoryGame/Saved/SaveGames/server

# Post-install hints
CONFIG_HINT="O servidor e configurado pelo proprio jogo: no cliente, Servidores > Adicionar servidor com IP:7787 (porta trocada por causa do Dragonwilds, que ficou com a 7777), defina a senha de admin e reivindique o servidor. Ajustes finos ficam em /home/steam/.config/Epic/FactoryGame/Saved/Config/LinuxServer/ (ServerSettings.ini, GameUserSettings.ini) - pare o servidor antes de editar (systemctl stop satisfactory)."
SAVE_HINT="/home/steam/.config/Epic/FactoryGame/Saved/SaveGames/server/"
