# Satisfactory - definicao do jogo
# Fonte: Steam app 1690800 (Satisfactory Dedicated Server, build nativo Linux)

GAME_KEY=satisfactory
GAME_DISPLAY_NAME="Satisfactory"
STEAM_APP_ID=1690800

# Script de inicializacao dentro da pasta do jogo ({PORT} e substituido pela porta final)
# -log manda o log da Unreal para o stdout (o journald guarda, o painel le)
# -unattended evita qualquer prompt/janela em ambiente sem interface
START_SCRIPT=FactoryServer.sh
START_ARGS="-Port={PORT} -log -unattended"

# Portas (formato: porta/protocolo, separadas por espaco)
GAME_PORT=7777
GAME_PORTS="7777/udp 7777/tcp"
PORT_NOTES="Desde a 1.0 o servidor usa uma unica porta: 7777/UDP (trafego do jogo) e 7777/TCP (API de gerenciamento HTTPS usada pelo cliente para adotar/configurar o servidor). Abra os dois no roteador. As portas antigas 15000/15777 nao sao mais usadas. O jogo nao publica query A2S da Steam. A contagem no painel sai do log; quem tiver um token de admin da API pode trocar pela fonte 'API HTTP' (POST https://127.0.0.1:7777/api/v1 com corpo {\"function\":\"QueryServerState\"} e bearer:<token>), que devolve numConnectedPlayers."

# Recursos recomendados (usados se nao definidos no .env)
# A Coffee Stain recomenda 12GB de RAM; fabricas grandes passam disso, entao 16GB.
RECOMMENDED_MEMORY=16384
RECOMMENDED_CORES=4
RECOMMENDED_DISK_GB=32

# Pos-instalacao:
# O FactoryServer.sh procura steamclient.so em ~/.steam/sdk64; sem o symlink
# o servidor sobe mas nao registra na Steam (o cliente nao acha o servidor).
POST_INSTALL_CMD='
install -d -o steam -g steam /home/steam/.steam/sdk64
ln -sf /opt/steamcmd/linux64/steamclient.so /home/steam/.steam/sdk64/steamclient.so
chown -h steam:steam /home/steam/.steam/sdk64/steamclient.so

install -d -o steam -g steam /home/steam/.config/Epic/FactoryGame/Saved/SaveGames/server
'

# Cadastro automatico no painel (usado pelo deploy-docker.ps1)
# Os .ini so nascem depois do primeiro start (e de o servidor ser reivindicado no jogo).
CONFIG_PATH=/home/steam/.config/Epic/FactoryGame/Saved/Config/LinuxServer
CONFIG_FILES=/home/steam/.config/Epic/FactoryGame/Saved/Config/LinuxServer/ServerSettings.ini,/home/steam/.config/Epic/FactoryGame/Saved/Config/LinuxServer/GameUserSettings.ini
QUERY_PORT=0
PLAYER_SOURCE=log

# Dicas pos-instalacao
CONFIG_HINT="O servidor e configurado pelo proprio jogo: no cliente, Servidores > Adicionar servidor com IP:7777, defina a senha de admin e reivindique o servidor. Ajustes finos ficam em /home/steam/.config/Epic/FactoryGame/Saved/Config/LinuxServer/ (ServerSettings.ini, GameUserSettings.ini) - pare o servidor antes de editar (systemctl stop satisfactory)."
SAVE_HINT="/home/steam/.config/Epic/FactoryGame/Saved/SaveGames/server/"
