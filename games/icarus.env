# Icarus - game definition
# Source: Steam app 2089300 (Icarus Dedicated Server)
#
# WARNING: RocketWerkz does NOT publish a Linux build of the dedicated server - the depot
# only has the Windows files. This template downloads the Windows build
# (STEAM_PLATFORM=windows) and runs it via Wine inside the container, the same path
# used by the community Docker images and by games/enshrouded.env.

GAME_KEY=icarus
GAME_DISPLAY_NAME="Icarus"
STEAM_APP_ID=2089300

# No native Linux build: SteamCMD has to download the Windows files.
STEAM_PLATFORM=windows

# Runtime for the .exe: Proton, for ntsync (the distro's wine does not use it - verified).
#
# This game depends on Steam's game server API, and under Proton it only works if
# UMU_ID is the game's REAL appid. With UMU_ID=0 Proton propagates SteamAppId=0, the
# Steam init fails ("[AppId: 0] Game Server API initialized 0") and query port 27017
# never opens - the server stays up, invisible in the browser and with no count.
# win-run resolves it on its own by reading Binaries/Win64/steam_appid.txt.
WINDOWS_RUNTIME=proton
PROTON_VERSION=GE-Proton11-5
# Do NOT disable explorer.exe here: without it the server dies with
# "nodrv_CreateWindow" before it even creates Saved/Logs.
WINE_DLL_OVERRIDES="mscoree,mshtml="
# The Icarus server build opens a window even when headless - it needs the virtual X.
WINDOWS_RUNTIME_XVFB=1

# The binary is IcarusServer.exe, so the real start is the wrapper created in
# POST_INSTALL_CMD - it passes the arguments below on to the .exe via Wine.
# The game accepts the port on the command line (it takes precedence over Engine.ini).
#
# -log is NOT used: it opens a console WINDOW, which here would be stuck inside
# the virtual X with nobody to read it. What gets the log into the journal (and therefore
# into game-logs and the panel's log screen) is the pair -stdout -FullStdOutLogOutput:
# Unreal writes to the process stdout instead of only to the file. Without them
# game-logs goes silent precisely when the server is healthy, because the only
# stderr left is Wine's.
# The file in /opt/game/Icarus/Saved/Logs/ keeps existing as usual.
START_SCRIPT=start-icarus.sh
START_ARGS="-PORT={PORT} -QueryPort={QUERY_PORT} -stdout -FullStdOutLogOutput"

# Ports (format: port/protocol, separated by spaces)
GAME_PORT=17777
GAME_PORTS="17777/udp 27017/udp"
# 0 = the game's default ports, always (decision: curated games do not use the broker's assigned
# range; a second instance of the same game is rejected because the port is taken). The {PORT} in
# START_ARGS stays: with a fixed port it receives the default number. 1 = broker range.
PORTS_SHIFTABLE=0
PORT_NOTES="17777/UDP e a porta do jogo; 27017/UDP e a query da Steam, usada pelo navegador de servidores do proprio Icarus (sem ela o servidor nao aparece na lista e o painel nao consegue contar jogadores). A query NAO fica na 27015 padrao de proposito: o Palworld ja usa essa porta e, no NAT, uma porta externa so pode apontar para um destino. Sao UDP puro; nao abra TCP. O Icarus nao tem RCON nem API HTTP - a administracao e feita pelo AdminPassword dentro do jogo."

# Recommended resources (used if not defined in .env)
# RocketWerkz recommends 16GB; Wine adds a bit on top of that. Icarus is
# heavy on single-thread, so a fast core is worth more than many cores.
# The install takes ~10.5GB (Steam reports SizeOnDisk 10410648627), of which
# 1.1GB is just the .pdb symbols file. 32GB leaves room for saves, prospects and for
# staging an update.
RECOMMENDED_MEMORY=16384
RECOMMENDED_CORES=6
RECOMMENDED_DISK_GB=32

# Wine, xvfb and xauth now come from setup_windows_runtime (provision-game-lxc.sh),
# driven by WINDOWS_RUNTIME/WINDOWS_RUNTIME_XVFB up above. What is left here is only what
# is specific to Icarus:
#
# A low vm.max_map_count makes Unreal die with "Freeing X bytes from backup
# pool" under Wine. In an unprivileged CT the sysctl does not take (the value is not
# namespaced) - in that case set it on the Proxmox HOST:
#   sysctl -w vm.max_map_count=262144
#   echo "vm.max_map_count=262144" > /etc/sysctl.d/99-icarus.conf
PRE_INSTALL_CMD='
set -e
atual="$(cat /proc/sys/vm/max_map_count 2>/dev/null || echo 0)"
if [ "$atual" -lt 262144 ]; then
  sysctl -w vm.max_map_count=262144 >/dev/null 2>&1 \
    && echo "vm.max_map_count ajustado para 262144" \
    || echo "AVISO: nao foi possivel ajustar vm.max_map_count (atual: $atual) - ajuste no HOST Proxmox, senao o servidor pode cair com erro de memoria"
fi
'

# Post-install:
# 1) seeds ServerSettings.ini (the game only generates it when the first prospect is created,
#    so without this the panel's "Config" screen would open empty)
# 2) writes the wrapper systemd will call as START_SCRIPT
# The Wine prefix is no longer created here: win-run creates it on the first start, already
# under the virtual X (wineboot brings up explorer.exe and needs a display).
POST_INSTALL_CMD='
set -e
cfg_dir=/opt/game/Icarus/Saved/Config/WindowsServer
install -d -o steam -g steam /opt/game/Icarus/Saved/Config /opt/game/Icarus/Saved
install -d -o steam -g steam "$cfg_dir"
if [ ! -s "$cfg_dir/ServerSettings.ini" ]; then
  cat > "$cfg_dir/ServerSettings.ini" <<"INI"
[/Script/Icarus.DedicatedServerSettings]
SessionName=Icarus Dedicated
JoinPassword=
MaxPlayers=8
AdminPassword=TROQUE-ESTA-SENHA-ADMIN
ShutdownIfNotJoinedFor=300.000000
ShutdownIfEmptyFor=300.000000
AllowNonAdminsToLaunchProspects=True
AllowNonAdminsToDeleteProspects=False
LoadProspect=
CreateProspect=
ResumeProspect=True
LastProspectName=
INI
  chown steam:steam "$cfg_dir/ServerSettings.ini"
  echo "ServerSettings.ini criado - TROQUE A SENHA DE ADMIN antes de liberar o servidor"
else
  echo "ServerSettings.ini ja existe, mantido"
fi

cat > /opt/game/start-icarus.sh <<"SH"
#!/usr/bin/env bash
# Starts the Icarus server with the runtime configured at deploy (wine + virtual X).
# Prefix, WINEDLLOVERRIDES, XDG_RUNTIME_DIR and xvfb-run live in win-run,
# installed by provision-game-lxc.sh and shared among the games.
# The arguments come from START_ARGS rendered in systemd (port and query port).
set -Eeuo pipefail

echo "start-icarus: args: $*"
cd /opt/game

# We call the Shipping binary DIRECTLY, not /opt/game/IcarusServer.exe.
# The root .exe is only the Unreal bootstrap (256KB): headless it starts, stays
# alive using ~1s of CPU and NEVER spawns the server process - it opens no port,
# writes no log, and systemd considers it "active" the whole time. A service that is
# up but serves nothing is worse than one that fails, so we skip the middleman.
#
# The virtual X is still needed (Shipping creates a window at startup), but what
# applies xvfb-run now is win-run, via WINDOWS_RUNTIME_XVFB=1.
exec win-run /opt/game/Icarus/Binaries/Win64/IcarusServer-Win64-Shipping.exe "$@"
SH
chmod 755 /opt/game/start-icarus.sh
chown steam:steam /opt/game/start-icarus.sh
'

# Automatic registration in the panel (used by deploy-docker.ps1)
CONFIG_PATH=/opt/game/Icarus/Saved/Config/WindowsServer
CONFIG_FILES=/opt/game/Icarus/Saved/Config/WindowsServer/ServerSettings.ini
QUERY_PORT=27017
PLAYER_SOURCE=a2s

# Folders the panel's Backups screen stores in the .tar.gz (comma separated).
# It is the game SAVE, not the root: the whole /opt/game carries the binaries that SteamCMD
# downloads again for free. A path that does not exist yet is skipped with a warning, so it may
# point to the folder that only appears on the first start.
BACKUP_PATHS=/opt/game/Icarus/Saved/PlayerData,/opt/game/Icarus/Saved/Prospects

# Post-install hints
CONFIG_HINT="/opt/game/Icarus/Saved/Config/WindowsServer/ServerSettings.ini - ajuste SessionName (nome na lista), MaxPlayers, JoinPassword (senha de entrada, vazio = aberto) e AdminPassword. O servidor sobe vazio: quem cria o mundo e um jogador conectado, escolhendo o prospect no menu do jogo (ou preencha CreateProspect/LoadProspect no ini). ShutdownIfEmptyFor/ShutdownIfNotJoinedFor estao em 300s - suba para nao derrubar o prospect quando todo mundo sai; o systemd reinicia o servico logo em seguida. Pare o servidor antes de editar (systemctl stop icarus), porque o proprio jogo reescreve esse arquivo ao sair."
SAVE_HINT="/opt/game/Icarus/Saved/PlayerData/ e /opt/game/Icarus/Saved/Prospects/"
