# Icarus - definicao do jogo
# Fonte: Steam app 2089300 (Icarus Dedicated Server)
#
# ATENCAO: a RocketWerkz NAO publica build Linux do servidor dedicado - o depot
# so tem os arquivos de Windows. Este template baixa o build Windows
# (STEAM_PLATFORM=windows) e roda via Wine dentro do container, o mesmo caminho
# usado pelas imagens Docker da comunidade e pelo games/enshrouded.env.

GAME_KEY=icarus
GAME_DISPLAY_NAME="Icarus"
STEAM_APP_ID=2089300

# Sem build nativo Linux: o SteamCMD precisa baixar os arquivos de Windows.
STEAM_PLATFORM=windows

# O binario e o IcarusServer.exe, entao o start real e o wrapper criado no
# POST_INSTALL_CMD - ele repassa os argumentos abaixo para o .exe via Wine.
# O jogo aceita porta por linha de comando (tem precedencia sobre o Engine.ini).
#
# -log NAO e usado: ele abre uma JANELA de console, que aqui ficaria presa dentro
# do X virtual sem ninguem para ler. Quem faz o log chegar ao journal (e portanto
# ao game-logs e a tela de logs do painel) e o par -stdout -FullStdOutLogOutput:
# a Unreal escreve no stdout do processo em vez de so no arquivo. Sem eles o
# game-logs fica mudo justamente quando o servidor esta saudavel, porque o unico
# stderr que sobra e o do Wine.
# O arquivo em /opt/game/Icarus/Saved/Logs/ continua existindo normalmente.
START_SCRIPT=start-icarus.sh
START_ARGS="-PORT={PORT} -QueryPort=27015 -stdout -FullStdOutLogOutput"

# Portas (formato: porta/protocolo, separadas por espaco)
GAME_PORT=17777
GAME_PORTS="17777/udp 27015/udp"
PORT_NOTES="17777/UDP e a porta do jogo; 27015/UDP e a query da Steam, usada pelo navegador de servidores do proprio Icarus (sem ela o servidor nao aparece na lista e o painel nao consegue contar jogadores). Sao UDP puro; nao abra TCP. O Icarus nao tem RCON nem API HTTP - a administracao e feita pelo AdminPassword dentro do jogo."

# Recursos recomendados (usados se nao definidos no .env)
# A RocketWerkz recomenda 16GB; o Wine soma um pouco em cima disso. O Icarus e
# pesado em single-thread, entao core rapido vale mais que muitos cores.
# A instalacao ocupa ~10,5GB (a Steam reporta SizeOnDisk 10410648627), dos quais
# 1,1GB e so o .pdb de simbolos. 32GB deixam folga para saves, prospects e para
# o staging de uma atualizacao.
RECOMMENDED_MEMORY=16384
RECOMMENDED_CORES=6
RECOMMENDED_DISK_GB=32

# Pre-instalacao: o Wine precisa existir ANTES do SteamCMD baixar o build Windows.
# O servidor e um .exe 64 bits, entao o pacote wine (64) basta; a parte i386 e
# opcional e por isso nao derruba o deploy se o nome do pacote mudar.
#
# O xvfb NAO e opcional aqui: diferente do Enshrouded (console puro), o build de
# servidor do Icarus tenta criar uma JANELA na largada. Sem display o Wine morre
# com "Application tried to create a window, but no driver could be loaded" e
# exit 41, antes mesmo de criar o Saved/Logs. O X virtual resolve.
# O vm.max_map_count baixo faz a Unreal morrer com "Freeing X bytes from backup
# pool" sob Wine. Em CT nao privilegiado o sysctl nao pega (o valor nao e
# namespaced) - nesse caso ajuste no HOST Proxmox:
#   sysctl -w vm.max_map_count=262144
#   echo "vm.max_map_count=262144" > /etc/sysctl.d/99-icarus.conf
PRE_INSTALL_CMD='
set -e
export DEBIAN_FRONTEND=noninteractive
if command -v wine >/dev/null 2>&1; then
  echo "Wine ja instalado: $(wine --version)"
else
  dpkg --add-architecture i386
  apt-get update
  apt-get install -y --no-install-recommends wine || apt-get install -y --no-install-recommends wine64
  apt-get install -y --no-install-recommends wine32:i386 || echo "wine32:i386 indisponivel, seguindo apenas com 64 bits"
  command -v wine >/dev/null 2>&1 || { echo "Wine nao ficou disponivel apos a instalacao"; exit 1; }
  echo "Wine instalado: $(wine --version)"
fi

# O xauth vai EXPLICITO: ele e so um Recommends do xvfb, entao com
# --no-install-recommends nao vem junto, e o xvfb-run morre com
# "xvfb-run: error: xauth command not found" (exit 3) antes de chamar o Wine.
if command -v xvfb-run >/dev/null 2>&1 && command -v xauth >/dev/null 2>&1; then
  echo "Xvfb + xauth ja instalados"
else
  apt-get update
  apt-get install -y --no-install-recommends xvfb xauth
  command -v xvfb-run >/dev/null 2>&1 || { echo "xvfb-run nao ficou disponivel - o servidor nao sobe sem display"; exit 1; }
  command -v xauth >/dev/null 2>&1 || { echo "xauth nao ficou disponivel - o xvfb-run nao funciona sem ele"; exit 1; }
  echo "Xvfb + xauth instalados"
fi

atual="$(cat /proc/sys/vm/max_map_count 2>/dev/null || echo 0)"
if [ "$atual" -lt 262144 ]; then
  sysctl -w vm.max_map_count=262144 >/dev/null 2>&1 \
    && echo "vm.max_map_count ajustado para 262144" \
    || echo "AVISO: nao foi possivel ajustar vm.max_map_count (atual: $atual) - ajuste no HOST Proxmox, senao o servidor pode cair com erro de memoria"
fi
'

# Pos-instalacao:
# 1) cria o prefixo do Wine (64 bits) do usuario steam, uma unica vez
# 2) semeia o ServerSettings.ini (o jogo so o gera ao criar o primeiro prospect,
#    entao sem isso a tela "Config" do painel abriria vazia)
# 3) escreve o wrapper que o systemd vai chamar como START_SCRIPT
POST_INSTALL_CMD='
set -e
install -d -o steam -g steam /home/steam/.wine-icarus
install -d -o steam -g steam -m 0700 /tmp/.xdg-icarus-init
if [ ! -f /home/steam/.wine-icarus/system.reg ]; then
  echo "Criando prefixo do Wine (primeira vez, demora um pouco)..."
  # Sem "|| true": prefixo meio-criado faz o servidor morrer na largada a cada
  # start, e o erro so apareceria depois, disfarcado de falha do jogo.
  # xvfb-run tambem aqui: o proprio wineboot sobe o explorer.exe, que precisa de
  # display. Sem ele o init "passa" pela metade e o servidor so quebra depois.
  su - steam -c "XDG_RUNTIME_DIR=/tmp/.xdg-icarus-init WINEPREFIX=/home/steam/.wine-icarus WINEARCH=win64 WINEDEBUG=fixme-all xvfb-run -a -s \"-screen 0 640x480x24 -nolisten tcp\" wineboot --init" \
    || { echo "wineboot --init falhou - o prefixo do Wine nao ficou utilizavel"; exit 1; }
  su - steam -c "XDG_RUNTIME_DIR=/tmp/.xdg-icarus-init WINEPREFIX=/home/steam/.wine-icarus wineserver -w"
else
  echo "Prefixo do Wine ja existe, mantido"
fi

cfg_dir=/opt/game/Icarus/Saved/Config/WindowsServer
install -d -o steam -g steam /opt/game/Icarus/Saved/Config /opt/game/Icarus/Saved
install -d -o steam -g steam "$cfg_dir"
if [ ! -s "$cfg_dir/ServerSettings.ini" ]; then
  cat > "$cfg_dir/ServerSettings.ini" <<"INI"
[/Script/Icarus.DedicatedServerSettings]
SessionName=Icarus Dedicated
JoinPassword=
MaxPlayers=8
AdminPassword=TROQUE-ESTA-SENHA-ADMIN
ShutdownIfNotJoinedFor=300.000000
ShutdownIfEmptyFor=300.000000
AllowNonAdminsToLaunchProspects=True
AllowNonAdminsToDeleteProspects=False
LoadProspect=
CreateProspect=
ResumeProspect=True
LastProspectName=
INI
  chown steam:steam "$cfg_dir/ServerSettings.ini"
  echo "ServerSettings.ini criado - TROQUE A SENHA DE ADMIN antes de liberar o servidor"
else
  echo "ServerSettings.ini ja existe, mantido"
fi

cat > /opt/game/start-icarus.sh <<"SH"
#!/usr/bin/env bash
# Sobe o IcarusServer.exe via Wine (o jogo nao tem build Linux).
# Os argumentos vem do START_ARGS renderizado no systemd (porta e query port).
set -Eeuo pipefail

export HOME=/home/steam
export WINEPREFIX=/home/steam/.wine-icarus
export WINEARCH=win64
export WINEDLLOVERRIDES="mscoree,mshtml="

# Servico systemd nao passa por PAM, entao ninguem cria o XDG_RUNTIME_DIR e o
# libwayland-client cospe "XDG_RUNTIME_DIR is invalid or not set" no journal.
# A mensagem e inofensiva (bug 1093464 do Debian), mas atrapalha o diagnostico -
# apontar para um diretorio proprio 0700 do steam resolve.
export XDG_RUNTIME_DIR="/tmp/.xdg-icarus-$(id -u)"
mkdir -p "$XDG_RUNTIME_DIR"
chmod 700 "$XDG_RUNTIME_DIR"

# NAO use WINEDEBUG=-all aqui: ele silencia as linhas "err:" do Wine, que sao a
# unica pista quando o .exe morre na largada. fixme-all corta so o ruido.
export WINEDEBUG="${WINEDEBUG:-fixme-all}"

echo "start-icarus: $(wine --version), prefixo $WINEPREFIX, args: $*"
cd /opt/game

# Chamamos o binario Shipping DIRETO, e nao o /opt/game/IcarusServer.exe.
# O .exe da raiz e so o bootstrap da Unreal (256KB): sem interface ele sobe, fica
# vivo consumindo ~1s de CPU e NUNCA gera o processo do servidor - nao abre porta,
# nao escreve log, e o systemd o considera "active" o tempo todo. Um servico de
# pe que nao serve nada e pior que um que falha, entao pulamos o intermediario.
#
# O xvfb-run continua necessario: o proprio Shipping cria uma janela na largada.
# -a = escolhe um display livre, importante quando o systemd reinicia rapido e o
# lock do display anterior ainda nao sumiu.
exec xvfb-run -a -s "-screen 0 640x480x24 -nolisten tcp" \
  wine /opt/game/Icarus/Binaries/Win64/IcarusServer-Win64-Shipping.exe "$@"
SH
chmod 755 /opt/game/start-icarus.sh
chown steam:steam /opt/game/start-icarus.sh
'

# Cadastro automatico no painel (usado pelo deploy-docker.ps1)
CONFIG_PATH=/opt/game/Icarus/Saved/Config/WindowsServer
CONFIG_FILES=/opt/game/Icarus/Saved/Config/WindowsServer/ServerSettings.ini
QUERY_PORT=27015
PLAYER_SOURCE=a2s

# Dicas pos-instalacao
CONFIG_HINT="/opt/game/Icarus/Saved/Config/WindowsServer/ServerSettings.ini - ajuste SessionName (nome na lista), MaxPlayers, JoinPassword (senha de entrada, vazio = aberto) e AdminPassword. O servidor sobe vazio: quem cria o mundo e um jogador conectado, escolhendo o prospect no menu do jogo (ou preencha CreateProspect/LoadProspect no ini). ShutdownIfEmptyFor/ShutdownIfNotJoinedFor estao em 300s - suba para nao derrubar o prospect quando todo mundo sai; o systemd reinicia o servico logo em seguida. Pare o servidor antes de editar (systemctl stop icarus), porque o proprio jogo reescreve esse arquivo ao sair."
SAVE_HINT="/opt/game/Icarus/Saved/PlayerData/ e /opt/game/Icarus/Saved/Prospects/"
