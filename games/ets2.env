# Euro Truck Simulator 2 - game definition
# Source: Steam app 1948160 (Euro Truck Simulator 2 Dedicated Server, native Linux build) and the
# official SCS documentation: modding.scssoft.com/wiki/Documentation/Tools/Dedicated_Server
#
# The server does NOT start on its own: it requires server_packages.sii and server_packages.dat, which
# only the GAME generates (game console, with a map loaded: `export_server_packages`). It is through those
# two files that the DLCs and MODS come in: the server downloads no mod at all (it runs without the
# Steam client, it does not see the Workshop), it only applies what the exporter's profile had active.
# Every player needs the SAME mods subscribed in the Workshop.

GAME_KEY=ets2
GAME_DISPLAY_NAME="Euro Truck Simulator 2"
STEAM_APP_ID=1948160

# The POST_INSTALL_CMD wrapper, not the binary directly: it puts the ports into
# server_config.sii (the server does NOT accept the port as an argument) and waits for the packages.
START_SCRIPT=start-ets2.sh
START_ARGS="{PORT} {QUERY_PORT}"

# Ports (format: port/protocol, separated by spaces)
# 27018/27019, and NOT the default 27015/27016: on the router (1:1 NAT) 27015 belongs to Palworld,
# 27016 to DayZ and 27017 to Icarus. Here nobody types a port - the player finds the server
# in the game's list -, so moving off the default costs nothing. The query stays within
# 27015-27020, which is the range in which SCS says the server shows up in the LAN list.
# The SCS docs ask for TCP AND UDP on both.
GAME_PORT=27018
QUERY_PORT=27019
GAME_PORTS="27018/udp 27018/tcp 27019/udp 27019/tcp"
# 0 = fixed ports (repository decision: curated games do not use the broker's assigned range).
PORTS_SHIFTABLE=0
PORT_NOTES="27018 (conexao) e 27019 (consulta), TCP e UDP nas duas - fora das padrao 27015/27016 porque no roteador elas ja sao do Palworld e do DayZ. As portas virtuais 100/101 do server_config.sii NAO precisam de redirecionamento."

# Recommended resources. The server is light (it renders nothing); the disk is the map's with the DLCs.
RECOMMENDED_MEMORY=4096
RECOMMENDED_CORES=2
RECOMMENDED_DISK_GB=20

# libX11: the server is headless, but the binary links against libX11 and does not load without it
# ("libX11.so.6: cannot open shared object file") - measured on the first CT. Only the library,
# no X server and no recommends.
PRE_INSTALL_CMD='
export DEBIAN_FRONTEND=noninteractive
dpkg -s libx11-6 >/dev/null 2>&1 || { apt-get update -q && apt-get install -y --no-install-recommends libx11-6; }
'

# Post-install:
# 1) steamclient.so in ~/.steam/sdk64: the SCS docs say the Linux server does not start without it
#    (the same case as Palworld)
# 2) the wrapper systemd calls as START_SCRIPT
POST_INSTALL_CMD='
set -e
install -d -o steam -g steam /home/steam/.steam /home/steam/.steam/sdk64 /opt/game/server-home
ln -sf /opt/steamcmd/linux64/steamclient.so /home/steam/.steam/sdk64/steamclient.so
chown -h steam:steam /home/steam/.steam/sdk64/steamclient.so

cat > /opt/game/start-ets2.sh <<"SH"
#!/usr/bin/env bash
# Starts the ETS2 server. Receives the connection port and the query port from systemd.
set -Eeuo pipefail
home=/opt/game/server-home
port="${1:-27018}"
query="${2:-27019}"
bin=/opt/game/bin/linux_x64/eurotrucks2_server
cfg="$home/server_config.sii"
mkdir -p "$home"
cd /opt/game

# The Linux server IGNORES -homedir (measured: the log said "Home directory:
# /home/steam/.local/share/Euro Truck Simulator 2" and the uploaded packages were not found).
# So the default folder becomes a link to /opt/game/server-home: that is what the Files screen
# can reach - the default path has a space, which the panel rejects. Whatever the server already
# created in the default folder is moved here first (without overwriting anything).
default_home="/home/steam/.local/share/Euro Truck Simulator 2"
if [ ! -L "$default_home" ]; then
  mkdir -p "$(dirname "$default_home")"
  if [ -d "$default_home" ]; then
    cp -an "$default_home"/. "$home"/
    rm -rf "$default_home"
  fi
  ln -s "$home" "$default_home"
fi

# Without the packages the server dies at startup, and systemd would restart it in a loop. Worse: on
# CREATION through the panel that would fail the install and delete the CT, and the packages can only be
# uploaded AFTER the CT exists. So it waits, saying in the log what is missing; once the
# two files arrive (panel Files screen), the server starts on its own within 30 s.
while [ ! -s "$home/server_packages.sii" ] || [ ! -s "$home/server_packages.dat" ]; do
  echo "start-ets2: aguardando server_packages.sii e server_packages.dat em $home"
  echo "start-ets2: gere no JOGO (console, com mapa carregado): export_server_packages - com os mods ativos no perfil"
  sleep 30
done

# server_config.sii is created on the first run, with the default ports (27015/27016). Generate,
# stop, and change only the two physical ports - the rest (name, password, slots) is up to the admin.
if [ ! -s "$cfg" ]; then
  echo "start-ets2: gerando server_config.sii (primeira execucao)"
  "$bin" -nosingle >/dev/null 2>&1 &
  pid=$!
  for _ in $(seq 1 60); do [ -s "$cfg" ] && break; sleep 1; done
  kill "$pid" 2>/dev/null || true
  wait "$pid" 2>/dev/null || true
fi
if [ -s "$cfg" ]; then
  sed -i -E "s/(connection_dedicated_port:)[[:space:]]*[0-9]+/\1 $port/; s/(query_dedicated_port:)[[:space:]]*[0-9]+/\1 $query/" "$cfg"
fi

# Above 8 slots, max_players in server_config.sii alone does not count: the real limit is
# g_max_convoy_size in config_ds.cfg (up to 128, game 1.50+), and the server REWRITES that
# file with the default (8) on exit - that is why it is made read-only after being adjusted
# (recipe measured by the community; without the chmod the change is lost on the first restart). The value
# follows max_players: the admin only edits one place.
ds="$home/config_ds.cfg"
max=$(sed -n -E "s/^[[:space:]]*max_players:[[:space:]]*([0-9]+).*/\1/p" "$cfg" 2>/dev/null | head -n 1 || true)
if [ -n "$max" ]; then
  [ "$max" -gt 128 ] && max=128
  [ "$max" -lt 8 ] && max=8
  [ -e "$ds" ] && chmod u+w "$ds"
  if [ -s "$ds" ] && grep -q "g_max_convoy_size" "$ds"; then
    sed -i -E "s/^([[:space:]]*uset[[:space:]]+g_max_convoy_size[[:space:]]+).*/\1\"$max\"/" "$ds"
  else
    echo "uset g_max_convoy_size \"$max\"" >> "$ds"
  fi
  chmod 444 "$ds"
  echo "start-ets2: g_max_convoy_size = $max (config_ds.cfg, so leitura)"
fi

# stdbuf: with the output going to a pipe (journald) and not a terminal, the server libc buffers the
# log in 4 KB blocks and only flushes when a block fills up - the log screen lagged minutes behind
# what the server was doing, and a player joining only showed up when other text pushed the
# block out. Line buffered, each line reaches the journal right away.
exec stdbuf -oL -eL "$bin" -nosingle
SH
chmod 755 /opt/game/start-ets2.sh
chown -R steam:steam /opt/game/start-ets2.sh /opt/game/server-home
'

# Automatic registration in the panel (used by deploy-docker.ps1)
# server_config.sii (SiiNunit { ... }) opens in the field-by-field form (`sii` reader). The
# folder is still the file editor's, and that is where the packages are uploaded.
CONFIG_PATH=/opt/game/server-home
CONFIG_FILES=/opt/game/server-home/server_config.sii
# The query on 27019 is Steam's (it is what puts the server on the list).
PLAYER_SOURCE=a2s

LOG_PATH=
JOIN_RE=
LEAVE_RE=

# server-home holds everything that belongs to the server and not to SteamCMD: exported packages,
# config and the players' data.
BACKUP_PATHS=/opt/game/server-home

# Post-install hints
CONFIG_HINT="1) No JOGO, com os mods e DLCs que o servidor vai usar ativos no perfil e um mapa carregado, abra o console e rode export_server_packages. 2) Envie os dois arquivos gerados (server_packages.sii e server_packages.dat, na pasta de documentos do jogo) para /opt/game/server-home pela tela Arquivos - o servidor sobe sozinho em ate 30 s. 3) Depois da primeira subida, ajuste /opt/game/server-home/server_config.sii: lobby_name, password, max_players (ate 128 no jogo 1.50+; o servidor ajusta sozinho o g_max_convoy_size, mas acima de 8 CADA JOGADOR tambem precisa de g_max_convoy_size 128 no config.cfg do jogo (Documentos), senao nem ve o servidor na lista). Opcional: server_logon_token (gerado em steamcommunity.com/dev/managegameservers com o App ID do JOGO, 227300) para o servidor manter a mesma identidade entre reinicios. Pare o servidor antes de editar (systemctl stop ets2)."
SAVE_HINT="/opt/game/server-home/"
