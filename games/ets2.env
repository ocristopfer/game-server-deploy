# Euro Truck Simulator 2 - definicao do jogo
# Fonte: Steam app 1948160 (Euro Truck Simulator 2 Dedicated Server, build nativo Linux) e a
# documentacao oficial da SCS: modding.scssoft.com/wiki/Documentation/Tools/Dedicated_Server
#
# O servidor NAO sobe sozinho: ele exige server_packages.sii e server_packages.dat, que so o
# JOGO gera (console do jogo, com um mapa carregado: `export_server_packages`). E por esses
# dois arquivos que entram as DLCs e os MODS: o servidor nao baixa mod nenhum (roda sem o
# cliente Steam, nao ve a Workshop), so aplica o que o perfil de quem exportou tinha ativo.
# Cada jogador precisa ter os MESMOS mods inscritos na Workshop.

GAME_KEY=ets2
GAME_DISPLAY_NAME="Euro Truck Simulator 2"
STEAM_APP_ID=1948160

# O wrapper do POST_INSTALL_CMD, e nao o binario direto: ele poe as portas no
# server_config.sii (o servidor NAO aceita porta por argumento) e espera os pacotes.
START_SCRIPT=start-ets2.sh
START_ARGS="{PORT} {QUERY_PORT}"

# Portas (formato: porta/protocolo, separadas por espaco)
# 27018/27019, e NAO as padrao 27015/27016: no roteador (NAT 1:1) a 27015 e do Palworld, a
# 27016 do DayZ e a 27017 do Icarus. Aqui ninguem digita porta - o jogador acha o servidor
# pela lista do jogo -, entao sair da padrao nao custa nada. A query continua dentro de
# 27015-27020, que e a faixa em que a SCS diz que o servidor aparece na lista da LAN.
# A doc da SCS pede TCP E UDP nas duas.
GAME_PORT=27018
QUERY_PORT=27019
GAME_PORTS="27018/udp 27018/tcp 27019/udp 27019/tcp"
# 0 = portas fixas (decisao do repositorio: curado nao usa a faixa sorteada do broker).
PORTS_SHIFTABLE=0
PORT_NOTES="27018 (conexao) e 27019 (consulta), TCP e UDP nas duas - fora das padrao 27015/27016 porque no roteador elas ja sao do Palworld e do DayZ. As portas virtuais 100/101 do server_config.sii NAO precisam de redirecionamento."

# Recursos recomendados. O servidor e leve (nao renderiza nada); o disco e o do mapa com as DLCs.
RECOMMENDED_MEMORY=4096
RECOMMENDED_CORES=2
RECOMMENDED_DISK_GB=20

# libX11: o servidor e headless, mas o binario linka a libX11 e nao carrega sem ela
# ("libX11.so.6: cannot open shared object file") - medido no primeiro CT. So a biblioteca,
# sem servidor X nem recomendados.
PRE_INSTALL_CMD='
export DEBIAN_FRONTEND=noninteractive
dpkg -s libx11-6 >/dev/null 2>&1 || { apt-get update -q && apt-get install -y --no-install-recommends libx11-6; }
'

# Pos-instalacao:
# 1) steamclient.so em ~/.steam/sdk64: a doc da SCS diz que o servidor Linux nao sobe sem ela
#    (e o mesmo caso do Palworld)
# 2) o wrapper que o systemd chama como START_SCRIPT
POST_INSTALL_CMD='
set -e
install -d -o steam -g steam /home/steam/.steam /home/steam/.steam/sdk64 /opt/game/server-home
ln -sf /opt/steamcmd/linux64/steamclient.so /home/steam/.steam/sdk64/steamclient.so
chown -h steam:steam /home/steam/.steam/sdk64/steamclient.so

cat > /opt/game/start-ets2.sh <<"SH"
#!/usr/bin/env bash
# Sobe o servidor do ETS2. Recebe do systemd a porta de conexao e a de consulta.
set -Eeuo pipefail
home=/opt/game/server-home
port="${1:-27018}"
query="${2:-27019}"
bin=/opt/game/bin/linux_x64/eurotrucks2_server
cfg="$home/server_config.sii"
mkdir -p "$home"
cd /opt/game

# O servidor Linux IGNORA o -homedir (medido: o log dizia "Home directory:
# /home/steam/.local/share/Euro Truck Simulator 2" e os pacotes enviados nao eram achados).
# Entao a pasta padrao vira um link para /opt/game/server-home: e la que a tela Arquivos
# alcanca - o caminho padrao tem espaco, que o painel recusa. O que o servidor ja tiver
# criado na pasta padrao passa para ca antes (sem sobrescrever nada).
default_home="/home/steam/.local/share/Euro Truck Simulator 2"
if [ ! -L "$default_home" ]; then
  mkdir -p "$(dirname "$default_home")"
  if [ -d "$default_home" ]; then
    cp -an "$default_home"/. "$home"/
    rm -rf "$default_home"
  fi
  ln -s "$home" "$default_home"
fi

# Sem os pacotes o servidor morre na largada, e o systemd o reiniciaria em laco. Pior: na
# CRIACAO pelo painel isso reprovaria a instalacao e apagaria o CT, e os pacotes so podem ser
# enviados DEPOIS que o CT existe. Entao espera, dizendo no log o que falta; ao chegarem os
# dois arquivos (tela Arquivos do painel), o servidor sobe sozinho em ate 30 s.
while [ ! -s "$home/server_packages.sii" ] || [ ! -s "$home/server_packages.dat" ]; do
  echo "start-ets2: aguardando server_packages.sii e server_packages.dat em $home"
  echo "start-ets2: gere no JOGO (console, com mapa carregado): export_server_packages - com os mods ativos no perfil"
  sleep 30
done

# O server_config.sii nasce na primeira execucao, com as portas padrao (27015/27016). Gera,
# para, e troca so as duas portas fisicas - o resto (nome, senha, vagas) e de quem administra.
if [ ! -s "$cfg" ]; then
  echo "start-ets2: gerando server_config.sii (primeira execucao)"
  "$bin" -nosingle >/dev/null 2>&1 &
  pid=$!
  for _ in $(seq 1 60); do [ -s "$cfg" ] && break; sleep 1; done
  kill "$pid" 2>/dev/null || true
  wait "$pid" 2>/dev/null || true
fi
if [ -s "$cfg" ]; then
  sed -i -E "s/(connection_dedicated_port:)[[:space:]]*[0-9]+/\1 $port/; s/(query_dedicated_port:)[[:space:]]*[0-9]+/\1 $query/" "$cfg"
fi

# Acima de 8 vagas o max_players do server_config.sii sozinho nao vale: o limite de verdade e
# o g_max_convoy_size do config_ds.cfg (ate 128, jogo 1.50+), e o servidor REESCREVE esse
# arquivo com o padrao (8) ao sair - por isso ele fica so de leitura depois de ajustado
# (receita medida pela comunidade; sem o chmod a mudanca some no primeiro reinicio). O valor
# acompanha o max_players: quem administra so mexe num lugar.
ds="$home/config_ds.cfg"
max=$(sed -n -E "s/^[[:space:]]*max_players:[[:space:]]*([0-9]+).*/\1/p" "$cfg" 2>/dev/null | head -n 1 || true)
if [ -n "$max" ]; then
  [ "$max" -gt 128 ] && max=128
  [ "$max" -lt 8 ] && max=8
  [ -e "$ds" ] && chmod u+w "$ds"
  if [ -s "$ds" ] && grep -q "g_max_convoy_size" "$ds"; then
    sed -i -E "s/^([[:space:]]*uset[[:space:]]+g_max_convoy_size[[:space:]]+).*/\1\"$max\"/" "$ds"
  else
    echo "uset g_max_convoy_size \"$max\"" >> "$ds"
  fi
  chmod 444 "$ds"
  echo "start-ets2: g_max_convoy_size = $max (config_ds.cfg, so leitura)"
fi

# stdbuf: com a saida num pipe (journald), e nao num terminal, a libc do servidor junta o
# log em blocos de 4 KB e so solta quando o bloco enche - a tela de log ficava minutos atras
# do que o servidor fazia, e um jogador entrando aparecia so quando outro texto empurrava o
# bloco. Linha a linha, cada linha chega ao journal na hora.
exec stdbuf -oL -eL "$bin" -nosingle
SH
chmod 755 /opt/game/start-ets2.sh
chown -R steam:steam /opt/game/start-ets2.sh /opt/game/server-home
'

# Cadastro automatico no painel (usado pelo deploy-docker.ps1)
# Sem CONFIG_FILES: o .sii e o formato proprio da SCS (SiiNunit { ... }), que o formulario
# campo a campo nao le. A pasta abre no editor de arquivo, e e la que os pacotes sao enviados.
CONFIG_PATH=/opt/game/server-home
CONFIG_FILES=
# A consulta na 27019 e a da Steam (e ela que poe o servidor na lista).
PLAYER_SOURCE=a2s

LOG_PATH=
JOIN_RE=
LEAVE_RE=

# O server-home tem tudo que e do servidor e nao do SteamCMD: pacotes exportados, config e
# os dados dos jogadores.
BACKUP_PATHS=/opt/game/server-home

# Dicas pos-instalacao
CONFIG_HINT="1) No JOGO, com os mods e DLCs que o servidor vai usar ativos no perfil e um mapa carregado, abra o console e rode export_server_packages. 2) Envie os dois arquivos gerados (server_packages.sii e server_packages.dat, na pasta de documentos do jogo) para /opt/game/server-home pela tela Arquivos - o servidor sobe sozinho em ate 30 s. 3) Depois da primeira subida, ajuste /opt/game/server-home/server_config.sii: lobby_name, password, max_players (ate 128 no jogo 1.50+; o servidor ajusta sozinho o g_max_convoy_size, mas acima de 8 CADA JOGADOR tambem precisa de g_max_convoy_size 128 no config.cfg do jogo (Documentos), senao nem ve o servidor na lista). Opcional: server_logon_token (gerado em steamcommunity.com/dev/managegameservers com o App ID do JOGO, 227300) para o servidor manter a mesma identidade entre reinicios. Pare o servidor antes de editar (systemctl stop ets2)."
SAVE_HINT="/opt/game/server-home/"
