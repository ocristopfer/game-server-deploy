# TeamSpeak 6 Server - definicao do jogo
# Fonte: https://github.com/teamspeak/teamspeak6-server (nao e Steam - tarball direto do
# GitHub da TeamSpeak, ainda em beta). Provisionamento proprio: provision-teamspeak-lxc.sh
# (nao usa SteamCMD nem o provision-game-lxc.sh dos outros jogos).

GAME_KEY=teamspeak
GAME_DISPLAY_NAME="TeamSpeak 6 Server"

# Diz ao deploy-game.ps1 qual script mandar pro Proxmox em vez do padrao
# provision-game-lxc.sh (que so sabe instalar via SteamCMD).
PROVISION_SCRIPT=provision-teamspeak-lxc.sh

# Versao fixa de proposito (mesmo motivo do PROTON_VERSION no README): "latest" trocaria
# de versao sozinho num redeploy, e o TS6 ainda esta em beta. Para atualizar, mude aqui e
# rode o deploy de novo (ou rode 'update-game' dentro do CT pra reinstalar a mesma versao).
DOWNLOAD_VERSION=v6.0.0-beta12.1

# Porta de voz (a mesma variavel GAME_PORT dos outros jogos)
GAME_PORT=9987
GAME_PORTS="9987/udp 30033/tcp"
PORT_NOTES="9987/UDP e a voz; 30033/TCP e transferencia de arquivos - essas duas vao no roteador. As portas de query (10011 raw, 10022 ssh, 10080 http/WebQuery) ficam so em 127.0.0.1 dentro do CT - NAO redirecione nenhuma; o painel fala com a API por dentro do container, via SSH."

# Recursos recomendados - e um servidor de voz, nao um jogo: bem mais leve que os outros
RECOMMENDED_MEMORY=1024
RECOMMENDED_CORES=1
RECOMMENDED_DISK_GB=8

# ----- Cadastro automatico no painel -----
# Sem arquivo .ini fixo (administracao e via ServerQuery/WebQuery), entao a tela "Arquivos"
# abre na raiz da instalacao.
CONFIG_PATH=/opt/game
CONFIG_FILES=

# TeamSpeak nao publica A2S da Steam. Fica em log (so contagem) ate o admin configurar a
# API HTTP pelo assistente do painel (ver CONFIG_HINT abaixo) - mesmo fluxo documentado
# pro Palworld: a URL/api-key so existem depois do primeiro start.
QUERY_PORT=0
PLAYER_SOURCE=log
LOG_PATH=
JOIN_RE=
LEAVE_RE=

# O save de verdade: contas, canais, permissoes (sqlitedb) e uploads de canal (files) -
# nao a instalacao inteira.
BACKUP_PATHS=/opt/game/tsserver.sqlitedb,/opt/game/files

CONFIG_HINT="Sem arquivo .ini: a administracao e via ServerQuery/WebQuery. As credenciais do primeiro start (token de admin do cliente, login/senha do ServerQuery, api-key do WebQuery) ficam em /opt/game/CREDENTIALS.txt - leia com 'pct exec <CTID> -- cat /opt/game/CREDENTIALS.txt' ANTES de perder, o TeamSpeak so mostra isso UMA VEZ. Para o painel mostrar jogadores conectados, va em Configurar contagem > API HTTP: URL http://127.0.0.1:10080/1/clientlist, campo lista = body, autenticacao bearer:<api-key>. Sem licenca paga (https://sales.teamspeak.com/), o servidor aceita ate 1 virtual server e 32 slots."
SAVE_HINT="/opt/game/tsserver.sqlitedb (contas, canais, permissoes, grupos) e /opt/game/files (uploads de canal)"
