# V Rising - game definition
# Source: Steam app 1829350 (V Rising Dedicated Server) and Stunlock's official
# instructions (github.com/StunlockStudios/vrising-dedicated-server-instructions).
#
# WARNING: Stunlock does NOT publish a Linux build of the dedicated server - the depot only has
# the Windows files. This template downloads the Windows build (STEAM_PLATFORM=windows)
# and runs it via Proton inside the container, the same path as Enshrouded and Icarus.
#
# V Rising is NOT in LinuxGSM: that is why the "Add game" form search
# did not find it, and it enters the catalog through here.

GAME_KEY=vrising
GAME_DISPLAY_NAME="V Rising"
STEAM_APP_ID=1829350

# No native Linux build: SteamCMD has to download the Windows files.
STEAM_PLATFORM=windows

# Proton-GE, and not the distro's wine: the server is Unity with plenty of threads, and Debian's
# wine has no esync/fsync - every synchronization primitive becomes an expensive syscall (the same
# bottleneck measured on Enshrouded). Proton brings fsync and uses ntsync when the CT exposes it.
# The price is Icarus's: under Proton the Steam game server API only works with the
# REAL appid, otherwise the query (9877) never opens. The wrapper below pins it (1604030, the
# game's). To go back to plain wine: WINDOWS_RUNTIME=wine and redeploy.
WINDOWS_RUNTIME=proton
PROTON_VERSION=GE-Proton11-5
# Ready for mods (BepInEx, through the panel's Mods screen), and at no cost without them - measured on a
# test V Rising: mscoree ENABLED (off the list, unlike the other Windows games
# here) is what lets BepInEx, which is .NET, load; and native winhttp is how
# it gets in (without BepInEx's winhttp.dll in the folder, Wine falls back to its own). Being here, a
# redeploy does not undo the tweak the Mods screen would make in /etc/game-runtime.env.
WINE_DLL_OVERRIDES="mshtml=;winhttp=n,b"
# The server is Unity and creates a window at launch even with nobody to see it; without a virtual
# X Proton dies with "nodrv_CreateWindow" before opening the port.
WINDOWS_RUNTIME_XVFB=1

# The binary is an .exe, so the real start is the wrapper created in POST_INSTALL_CMD, which
# passes the arguments below on to VRisingServer.exe via win-run.
# -gamePort/-queryPort take precedence over ServerHostSettings.json: the port the
# broker opened in the firewall is the one the game uses, even if someone edits the file.
START_SCRIPT=start-vrising.sh
START_ARGS="-gamePort {PORT} -queryPort {QUERY_PORT}"

# Ports (format: port/protocol, separated by spaces)
GAME_PORT=9876
GAME_PORTS="9876/udp 9877/udp"
QUERY_PORT=9877
# 0 = the game's default ports, always (decision: curated games do not use the broker's assigned
# range; a second instance of the same game is rejected because the port is taken). The {PORT} and
# {QUERY_PORT} in START_ARGS stay: with a fixed port they receive the default number.
# 1 = broker range (both placeholders are already there, so it is a matter of changing one number).
PORTS_SHIFTABLE=0
PORT_NOTES="9876/UDP e a porta do jogo (a que o jogador usa em Direct Connect); 9877/UDP e a query da Steam, que poe o servidor na lista e deixa o painel contar jogadores - e so responde com ListOnSteam true no ServerHostSettings.json. Sao UDP puro; nao abra TCP. O RCON (25575/TCP) so existe se ligado no ServerHostSettings.json - NAO exponha no roteador."

# Recommended resources (used if not defined in .env)
# The server sits at ~3GB of RAM with few players and grows with each player's
# castle; Proton adds a bit. The download is ~3GB, the saves are small.
# 12GB, and not 8, because of MODS: the first start with BepInEx generates the code of the whole
# game and reached 9.4GB on a test CT; with 6GB the OOM killer took the server down in
# a loop, and with 8GB there would be no headroom. The Mods screen warns below 10GB.
RECOMMENDED_MEMORY=12288
RECOMMENDED_CORES=4
RECOMMENDED_DISK_GB=20

# Post-install:
# 1) seeds the two .json configuration files in save-data/Settings from the defaults
#    shipped with the server itself. Without that the panel's "Config" screen would open empty: the
#    game only READS that folder, it never creates it.
# 2) writes the wrapper systemd will call as START_SCRIPT
POST_INSTALL_CMD='
set -e
install -d -o steam -g steam /opt/game/save-data /opt/game/save-data/Settings /opt/game/logs

defaults=/opt/game/VRisingServer_Data/StreamingAssets/Settings
for f in ServerHostSettings.json ServerGameSettings.json; do
  if [ ! -s "/opt/game/save-data/Settings/$f" ]; then
    if [ -s "$defaults/$f" ]; then
      install -o steam -g steam -m 0644 "$defaults/$f" "/opt/game/save-data/Settings/$f"
      echo "$f criado a partir do padrao do servidor"
      # The default ships with ListOnSteam false, and then query 9877 stays SILENT: the Steam game
      # server starts and logs in, but does not answer A2S (measured on CT 304, even from 127.0.0.1) - the
      # panel counts players through it. Only on a freshly created file: an existing one belongs to whoever
      # edited it. Whoever does not want to appear in the public list sets a Password.
      if [ "$f" = ServerHostSettings.json ]; then
        sed -i "s/\"ListOnSteam\": *false/\"ListOnSteam\": true/" "/opt/game/save-data/Settings/$f"
      fi
    else
      echo "AVISO: $defaults/$f nao existe - o servidor vai subir com os padroes internos"
    fi
  else
    echo "$f ja existe, mantido"
  fi
done

cat > /opt/game/start-vrising.sh <<"SH"
#!/usr/bin/env bash
# Starts the V Rising server with the runtime configured at deploy (Proton + virtual X).
# The arguments come from START_ARGS rendered in systemd (port and query port).
set -Eeuo pipefail
cd /opt/game

log=/opt/game/logs/VRisingServer.log
touch "$log"
# The server only writes its log to a file (-logFile). tail repeats it on stdout, which is
# what the journal keeps and the panel log screen reads; without it the journal would only have
# Wine noise. -F follows the file when the game recreates it on every start, and
# systemd kills tail together with the service (same cgroup).
tail -n 0 -F "$log" &

# Under Proton, the appid becomes the process SteamAppId. win-run reads it from steam_appid.txt
# next to the .exe; if the depot does not ship that file it would fall back to 0, and with 0 the game
# server API fails silently (server up, missing from the list and with no count in the panel -
# which is what Icarus did). That is why the game appid is hardcoded here when the file is missing.
if [ ! -s /opt/game/steam_appid.txt ]; then
  export UMU_ID=1604030 SteamAppId=1604030 SteamGameId=1604030
fi

# RELATIVE paths on purpose: they are the ones from the official example, and work the same under
# Proton (which would translate an absolute Linux path to Z:\...).
exec win-run /opt/game/VRisingServer.exe \
  -persistentDataPath ./save-data \
  -logFile ./logs/VRisingServer.log \
  "$@"
SH
chmod 755 /opt/game/start-vrising.sh
chown steam:steam /opt/game/start-vrising.sh
'

# Automatic registration in the panel (used by deploy-docker.ps1)
# CONFIG_FILES is what the "Config" screen opens as a form, field by field.
CONFIG_PATH=/opt/game/save-data/Settings
CONFIG_FILES=/opt/game/save-data/Settings/ServerHostSettings.json,/opt/game/save-data/Settings/ServerGameSettings.json
# Through the Steam query: 9877 is already open for the server list, and the format
# of V Rising's connection log changes between versions (the query does not).
PLAYER_SOURCE=a2s

LOG_PATH=
JOIN_RE=
LEAVE_RE=

# Folders the panel's Backups screen stores in the .tar.gz (comma separated).
# Saves = the worlds (v3/v4 depending on the game version); Settings = name, password, rules and
# the admin list. A path that does not exist yet is skipped with a warning.
BACKUP_PATHS=/opt/game/save-data/Saves,/opt/game/save-data/Settings

# Post-install hints
CONFIG_HINT="/opt/game/save-data/Settings/ServerHostSettings.json - ajuste Name (nome na lista), Description, Password (vazio = aberto), MaxConnectedUsers, SaveName e ListOnSteam/ListOnEOS (true para aparecer na lista publica; com ListOnSteam false a query 9877 nao responde e o painel nao conta jogadores). As regras do mundo (dano, drop, castelos) ficam em ServerGameSettings.json. Admins: poe o SteamID64 de cada um em /opt/game/save-data/Settings/adminlist.txt (um por linha). Pare o servidor antes de editar (systemctl stop vrising)."
SAVE_HINT="/opt/game/save-data/Saves/"
