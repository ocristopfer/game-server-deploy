# V Rising - definicao do jogo
# Fonte: Steam app 1829350 (V Rising Dedicated Server) e as instrucoes oficiais da
# Stunlock (github.com/StunlockStudios/vrising-dedicated-server-instructions).
#
# ATENCAO: a Stunlock NAO publica build Linux do servidor dedicado - o depot so tem
# os arquivos de Windows. Este template baixa o build Windows (STEAM_PLATFORM=windows)
# e roda via Proton dentro do container, o mesmo caminho do Enshrouded e do Icarus.
#
# O V Rising NAO esta no LinuxGSM: por isso a busca do formulario "Adicionar jogo"
# nao o encontrava, e ele entra no catalogo por aqui.

GAME_KEY=vrising
GAME_DISPLAY_NAME="V Rising"
STEAM_APP_ID=1829350

# Sem build nativo Linux: o SteamCMD precisa baixar os arquivos de Windows.
STEAM_PLATFORM=windows

# Proton-GE, e nao o wine da distro: o servidor e Unity com bastante thread, e o wine do
# Debian nao tem esync/fsync - cada primitiva de sincronizacao vira syscall cara (o mesmo
# gargalo medido no Enshrouded). O Proton traz fsync e usa o ntsync quando o CT o expoe.
# O preco e o do Icarus: sob Proton a API de game server da Steam so funciona com o
# appid REAL, senao a query (9877) nunca abre. O wrapper abaixo o fixa (1604030, o do
# jogo). Para voltar ao wine puro: WINDOWS_RUNTIME=wine e redeploy.
WINDOWS_RUNTIME=proton
PROTON_VERSION=GE-Proton11-5
# Ja pronto para mods (BepInEx, pela tela Mods do painel), e sem custo sem eles - medido num
# V Rising de teste: o mscoree LIGADO (fora da lista, ao contrario dos outros jogos de
# Windows daqui) e o que deixa o BepInEx, que e .NET, carregar; e o winhttp nativo e por onde
# ele entra (sem o winhttp.dll do BepInEx na pasta, o Wine cai no dele). Estando aqui, um
# redeploy nao desfaz o ajuste que a tela Mods faria em /etc/game-runtime.env.
WINE_DLL_OVERRIDES="mshtml=;winhttp=n,b"
# O servidor e Unity e cria janela na largada mesmo sem ninguem para ve-la; sem X
# virtual o Proton morre com "nodrv_CreateWindow" antes de abrir porta.
WINDOWS_RUNTIME_XVFB=1

# O binario e um .exe, entao o start real e o wrapper criado no POST_INSTALL_CMD, que
# repassa os argumentos abaixo para o VRisingServer.exe via win-run.
# -gamePort/-queryPort tem precedencia sobre o ServerHostSettings.json: a porta que o
# broker abriu no firewall e a que o jogo usa, mesmo que alguem edite o arquivo.
START_SCRIPT=start-vrising.sh
START_ARGS="-gamePort {PORT} -queryPort {QUERY_PORT}"

# Portas (formato: porta/protocolo, separadas por espaco)
GAME_PORT=9876
GAME_PORTS="9876/udp 9877/udp"
QUERY_PORT=9877
# 0 = portas padrao do jogo, sempre (decisao: curado nao usa a faixa sorteada do broker;
# uma segunda instancia do mesmo jogo e recusada com a porta ocupada). O {PORT} e o
# {QUERY_PORT} do START_ARGS continuam: com porta fixa eles recebem o numero padrao.
# 1 = faixa do broker (os dois marcadores ja estao ai, entao e trocar um numero).
PORTS_SHIFTABLE=0
PORT_NOTES="9876/UDP e a porta do jogo (a que o jogador usa em Direct Connect); 9877/UDP e a query da Steam, que poe o servidor na lista e deixa o painel contar jogadores - e so responde com ListOnSteam true no ServerHostSettings.json. Sao UDP puro; nao abra TCP. O RCON (25575/TCP) so existe se ligado no ServerHostSettings.json - NAO exponha no roteador."

# Recursos recomendados (usados se nao definidos no .env)
# O servidor fica em ~3GB de RAM com poucos jogadores e cresce com o castelo de cada
# um; o Proton soma um pouco. O download e ~3GB, os saves sao pequenos.
# 12GB, e nao 8, por causa dos MODS: a primeira subida com o BepInEx gera o codigo do jogo
# inteiro e chegou a 9,4GB num CT de teste; com 6GB o OOM killer derrubava o servidor em
# laco, e com 8GB nao sobraria folga. A tela Mods avisa abaixo de 10GB.
RECOMMENDED_MEMORY=12288
RECOMMENDED_CORES=4
RECOMMENDED_DISK_GB=20

# Pos-instalacao:
# 1) semeia os dois .json de configuracao em save-data/Settings a partir dos padroes
#    que vem no proprio servidor. Sem isso a tela "Config" do painel abriria vazia: o
#    jogo so LE essa pasta, nunca a cria.
# 2) escreve o wrapper que o systemd vai chamar como START_SCRIPT
POST_INSTALL_CMD='
set -e
install -d -o steam -g steam /opt/game/save-data /opt/game/save-data/Settings /opt/game/logs

defaults=/opt/game/VRisingServer_Data/StreamingAssets/Settings
for f in ServerHostSettings.json ServerGameSettings.json; do
  if [ ! -s "/opt/game/save-data/Settings/$f" ]; then
    if [ -s "$defaults/$f" ]; then
      install -o steam -g steam -m 0644 "$defaults/$f" "/opt/game/save-data/Settings/$f"
      echo "$f criado a partir do padrao do servidor"
      # O padrao vem com ListOnSteam false, e assim a query 9877 fica MUDA: o Steam game
      # server sobe e loga, mas nao responde A2S (medido no CT 304, ate de 127.0.0.1) - o
      # painel conta jogadores por ela. So no arquivo recem-criado: um existente e de quem
      # o editou. Quem nao quer aparecer na lista publica poe Password.
      if [ "$f" = ServerHostSettings.json ]; then
        sed -i "s/\"ListOnSteam\": *false/\"ListOnSteam\": true/" "/opt/game/save-data/Settings/$f"
      fi
    else
      echo "AVISO: $defaults/$f nao existe - o servidor vai subir com os padroes internos"
    fi
  else
    echo "$f ja existe, mantido"
  fi
done

cat > /opt/game/start-vrising.sh <<"SH"
#!/usr/bin/env bash
# Sobe o servidor do V Rising com o runtime configurado no deploy (Proton + X virtual).
# Os argumentos vem do START_ARGS renderizado no systemd (porta e query port).
set -Eeuo pipefail
cd /opt/game

log=/opt/game/logs/VRisingServer.log
touch "$log"
# O servidor so escreve log em arquivo (-logFile). O tail o repete no stdout, que e o
# que o journal guarda e a tela de logs do painel le; sem ele o journal so teria o
# ruido do Wine. -F acompanha o arquivo quando o jogo o recria a cada start, e o
# systemd mata o tail junto com o servico (mesmo cgroup).
tail -n 0 -F "$log" &

# Sob Proton, o appid vira o SteamAppId do processo. O win-run o le do steam_appid.txt
# ao lado do .exe; se o depot nao trouxer esse arquivo ele cairia em 0, e com 0 a API de
# game server falha calada (servidor de pe, fora da lista e sem contagem no painel -
# foi o que o Icarus fez). Por isso o do jogo vai fixo aqui quando o arquivo falta.
if [ ! -s /opt/game/steam_appid.txt ]; then
  export UMU_ID=1604030 SteamAppId=1604030 SteamGameId=1604030
fi

# Caminhos RELATIVOS de proposito: sao os do exemplo oficial, e valem igual para o
# Proton (que traduziria um caminho absoluto de Linux para Z:\...).
exec win-run /opt/game/VRisingServer.exe \
  -persistentDataPath ./save-data \
  -logFile ./logs/VRisingServer.log \
  "$@"
SH
chmod 755 /opt/game/start-vrising.sh
chown steam:steam /opt/game/start-vrising.sh
'

# Cadastro automatico no painel (usado pelo deploy-docker.ps1)
# CONFIG_FILES e o que a tela "Config" abre como formulario, campo a campo.
CONFIG_PATH=/opt/game/save-data/Settings
CONFIG_FILES=/opt/game/save-data/Settings/ServerHostSettings.json,/opt/game/save-data/Settings/ServerGameSettings.json
# Pela query da Steam: a 9877 ja esta aberta para a lista de servidores, e o formato
# do log de conexao do V Rising muda entre versoes (a query nao).
PLAYER_SOURCE=a2s

LOG_PATH=
JOIN_RE=
LEAVE_RE=

# Pastas que a tela Backups do painel guarda no .tar.gz (separadas por virgula).
# Saves = os mundos (v3/v4 conforme a versao do jogo); Settings = nome, senha, regras e
# a lista de admins. Caminho que ainda nao existe e ignorado com aviso.
BACKUP_PATHS=/opt/game/save-data/Saves,/opt/game/save-data/Settings

# Dicas pos-instalacao
CONFIG_HINT="/opt/game/save-data/Settings/ServerHostSettings.json - ajuste Name (nome na lista), Description, Password (vazio = aberto), MaxConnectedUsers, SaveName e ListOnSteam/ListOnEOS (true para aparecer na lista publica; com ListOnSteam false a query 9877 nao responde e o painel nao conta jogadores). As regras do mundo (dano, drop, castelos) ficam em ServerGameSettings.json. Admins: poe o SteamID64 de cada um em /opt/game/save-data/Settings/adminlist.txt (um por linha). Pare o servidor antes de editar (systemctl stop vrising)."
SAVE_HINT="/opt/game/save-data/Saves/"
