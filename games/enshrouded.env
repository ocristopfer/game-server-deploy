# Enshrouded - game definition
# Source: Steam app 2278520 (Enshrouded Dedicated Server)
#
# WARNING: Keen Games does NOT publish a Linux build of the dedicated server.
# This template downloads the Windows build (STEAM_PLATFORM=windows) and runs it via Proton
# inside the container.
#
# Why Proton and not the distro's wine: Debian's wine has neither esync nor fsync,
# so every Windows synchronization primitive (mutex, event, semaphore) becomes an
# expensive syscall. The Enshrouded server is heavily multi-threaded and that is where the
# bottleneck shows up. Proton-GE ships its own wine with fsync (futex_waitv) on by
# default, which replaces that with futex waits in the kernel.
# To go back to plain wine, just set WINDOWS_RUNTIME=wine.

GAME_KEY=enshrouded
GAME_DISPLAY_NAME="Enshrouded"
STEAM_APP_ID=2278520

# No native Linux build: SteamCMD has to download the Windows files.
STEAM_PLATFORM=windows

# Runtime for the .exe: the deploy installs Proton-GE and exposes the win-run command in the CT.
WINDOWS_RUNTIME=proton
PROTON_VERSION=GE-Proton11-5

# Conservative override, and this was MEASURED, not assumed: under Proton, disabling
# explorer.exe, services.exe or wbemprox.dll hangs the server at launch (RSS stuck
# at 34MB, no port, no log). Tested one by one. Proton already injects its own
# overrides on top of this one - including steam.exe=b and winebth.sys=d - so the gain
# from tweaking here is small and the risk, high.
WINE_DLL_OVERRIDES="mscoree,mshtml="

# The Enshrouded server is pure console - it does not need a virtual X.
WINDOWS_RUNTIME_XVFB=0

# The binary is an .exe, so the real start is the wrapper created in POST_INSTALL_CMD.
# The game does NOT accept the port on the command line - it comes from enshrouded_server.json.
START_SCRIPT=start-enshrouded.sh
START_ARGS=""

# Ports (format: port/protocol, separated by spaces)
GAME_PORT=15637
GAME_PORTS="15636/udp 15637/udp"
PORT_NOTES="15637/UDP e a porta principal (queryPort) - e a que o jogador digita no cliente. 15636/UDP (gamePort) deixou de ser usada a partir do Content Update #2, mas abrir as duas evita dor de cabeca com servidor em versao antiga. Sao UDP puro; nao abra TCP. A 15637 tambem responde a consulta A2S da Steam: e por ela que o painel conta os jogadores, e o log da os nomes."

# Recommended resources (used if not defined in .env)
# Keen Games recommends 16GB for 16 players; Wine adds a bit on top of that.
# The Windows build download is ~12GB, hence 40GB of disk.
RECOMMENDED_MEMORY=16384
RECOMMENDED_CORES=6
RECOMMENDED_DISK_GB=40

# No PRE_INSTALL_CMD: what installs Proton and prepares the environment now is
# setup_windows_runtime in provision-game-lxc.sh, driven by WINDOWS_RUNTIME
# up above. It runs before the game download.

# Post-install:
# 1) seeds enshrouded_server.json if it does not exist yet
# 2) writes the wrapper systemd will call as START_SCRIPT
# The prefix is no longer created here: Proton builds its own on the first run,
# inside STEAM_COMPAT_DATA_PATH (/home/steam/.proton-enshrouded).
POST_INSTALL_CMD='
set -e
install -d -o steam -g steam /opt/game/savegame /opt/game/logs

if [ ! -s /opt/game/enshrouded_server.json ]; then
  cat > /opt/game/enshrouded_server.json <<"JSON"
{
  "name": "Enshrouded Server",
  "saveDirectory": "./savegame",
  "logDirectory": "./logs",
  "ip": "0.0.0.0",
  "gamePort": 15636,
  "queryPort": 15637,
  "slotCount": 16,
  "voiceChatMode": "Proximity",
  "enableVoiceChat": false,
  "enableTextChat": false,
  "userGroups": [
    {
      "name": "Admin",
      "password": "TROQUE-ESTA-SENHA-ADMIN",
      "canKickBan": true,
      "canAccessInventories": true,
      "canEditBase": true,
      "canExtendBase": true,
      "reservedSlots": 0
    },
    {
      "name": "Friend",
      "password": "TROQUE-ESTA-SENHA-FRIEND",
      "canKickBan": false,
      "canAccessInventories": true,
      "canEditBase": true,
      "canExtendBase": false,
      "reservedSlots": 0
    },
    {
      "name": "Guest",
      "password": "TROQUE-ESTA-SENHA-GUEST",
      "canKickBan": false,
      "canAccessInventories": false,
      "canEditBase": false,
      "canExtendBase": false,
      "reservedSlots": 0
    }
  ]
}
JSON
  chown steam:steam /opt/game/enshrouded_server.json
  echo "enshrouded_server.json criado - TROQUE AS SENHAS antes de liberar o servidor"
else
  echo "enshrouded_server.json ja existe, mantido"
fi

cat > /opt/game/start-enshrouded.sh <<"SH"
#!/usr/bin/env bash
# Starts enshrouded_server.exe with the runtime configured at deploy (Proton).
# The whole environment - prefix, WINEDLLOVERRIDES, XDG_RUNTIME_DIR - lives in win-run,
# installed by provision-game-lxc.sh and shared among the games.
# The port does NOT come as an argument: the server reads everything from enshrouded_server.json.
set -Eeuo pipefail
cd /opt/game
exec win-run /opt/game/enshrouded_server.exe
SH
chmod 755 /opt/game/start-enshrouded.sh
chown steam:steam /opt/game/start-enshrouded.sh
'

# Automatic registration in the panel (used by deploy-docker.ps1)
CONFIG_PATH=/opt/game
CONFIG_FILES=/opt/game/enshrouded_server.json
# The A2S query is on the game port itself (queryPort). It counts; the log fills in the
# NAMES and takes over the count if the query does not answer.
QUERY_PORT=15637
PLAYER_SOURCE=a2s

# Counting by log: the server writes clear join and leave lines with the name.
# With (?P<name>...) on both sides the panel says exactly who is online.
# Empty LOG_PATH = reads the service output (journalctl).
LOG_PATH=
JOIN_RE="\[server\] Player '(?P<name>[^']+)' logged in"
LEAVE_RE="\[server\] Remove Player '(?P<name>[^']+)'"

# Folders the panel's Backups screen stores in the .tar.gz (comma separated).
# It is the game SAVE, not the root: the whole /opt/game carries the binaries that SteamCMD
# downloads again for free. A path that does not exist yet is skipped with a warning, so it may
# point to the folder that only appears on the first start.
BACKUP_PATHS=/opt/game/savegame

# Post-install hints
CONFIG_HINT="/opt/game/enshrouded_server.json - ajuste name, slotCount (max 16) e as senhas de userGroups (Admin/Friend/Guest). O jogador entra digitando IP:15637 e a senha do grupo dele. Pare o servidor antes de editar (systemctl stop enshrouded)."
SAVE_HINT="/opt/game/savegame/"
