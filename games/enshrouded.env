# Enshrouded - definicao do jogo
# Fonte: Steam app 2278520 (Enshrouded Dedicated Server)
#
# ATENCAO: a Keen Games NAO publica build Linux do servidor dedicado.
# Este template baixa o build Windows (STEAM_PLATFORM=windows) e roda via Proton
# dentro do container.
#
# Por que Proton e nao o wine da distro: o wine do Debian nao tem esync nem fsync,
# entao cada primitiva de sincronizacao do Windows (mutex, evento, semaforo) vira
# syscall cara. O servidor de Enshrouded e muito multi-thread e e ai que aparece o
# gargalo. O Proton-GE traz o proprio wine com fsync (futex_waitv) ligado por
# padrao, que troca isso por espera em futex no kernel.
# Para voltar ao wine puro, basta WINDOWS_RUNTIME=wine.

GAME_KEY=enshrouded
GAME_DISPLAY_NAME="Enshrouded"
STEAM_APP_ID=2278520

# Sem build nativo Linux: o SteamCMD precisa baixar os arquivos de Windows.
STEAM_PLATFORM=windows

# Runtime do .exe: o deploy instala o Proton-GE e expoe o comando win-run no CT.
WINDOWS_RUNTIME=proton
PROTON_VERSION=GE-Proton11-5

# Override conservador, e isto foi MEDIDO, nao presumido: sob Proton, desligar
# explorer.exe, services.exe ou wbemprox.dll trava o servidor na largada (RSS parado
# em 34MB, sem porta, sem log). Testados um a um. O Proton ja injeta os proprios
# overrides por cima deste - inclusive steam.exe=b e winebth.sys=d - entao o ganho
# de mexer aqui e pequeno e o risco, alto.
WINE_DLL_OVERRIDES="mscoree,mshtml="

# O servidor de Enshrouded e console puro - nao precisa de X virtual.
WINDOWS_RUNTIME_XVFB=0

# O binario e um .exe, entao o start real e o wrapper criado no POST_INSTALL_CMD.
# O jogo NAO aceita porta por linha de comando - vem do enshrouded_server.json.
START_SCRIPT=start-enshrouded.sh
START_ARGS=""

# Portas (formato: porta/protocolo, separadas por espaco)
GAME_PORT=15637
GAME_PORTS="15636/udp 15637/udp"
PORT_NOTES="15637/UDP e a porta principal (queryPort) - e a que o jogador digita no cliente. 15636/UDP (gamePort) deixou de ser usada a partir do Content Update #2, mas abrir as duas evita dor de cabeca com servidor em versao antiga. Sao UDP puro; nao abra TCP. O jogo nao publica query A2S da Steam, entao a contagem de jogadores do painel sai do log."

# Recursos recomendados (usados se nao definidos no .env)
# A Keen Games recomenda 16GB para 16 jogadores; o Wine soma um pouco em cima disso.
# O download do build Windows fica em ~12GB, por isso 40GB de disco.
RECOMMENDED_MEMORY=16384
RECOMMENDED_CORES=6
RECOMMENDED_DISK_GB=40

# Sem PRE_INSTALL_CMD: quem instala o Proton e prepara o ambiente agora e o
# setup_windows_runtime do provision-game-lxc.sh, guiado pelo WINDOWS_RUNTIME
# la em cima. Ele roda antes do download do jogo.

# Pos-instalacao:
# 1) semeia o enshrouded_server.json se ainda nao existir
# 2) escreve o wrapper que o systemd vai chamar como START_SCRIPT
# O prefixo nao e mais criado aqui: o Proton monta o dele sozinho no primeiro run,
# dentro de STEAM_COMPAT_DATA_PATH (/home/steam/.proton-enshrouded).
POST_INSTALL_CMD='
set -e
install -d -o steam -g steam /opt/game/savegame /opt/game/logs

if [ ! -s /opt/game/enshrouded_server.json ]; then
  cat > /opt/game/enshrouded_server.json <<"JSON"
{
  "name": "Enshrouded Server",
  "saveDirectory": "./savegame",
  "logDirectory": "./logs",
  "ip": "0.0.0.0",
  "gamePort": 15636,
  "queryPort": 15637,
  "slotCount": 16,
  "voiceChatMode": "Proximity",
  "enableVoiceChat": false,
  "enableTextChat": false,
  "userGroups": [
    {
      "name": "Admin",
      "password": "TROQUE-ESTA-SENHA-ADMIN",
      "canKickBan": true,
      "canAccessInventories": true,
      "canEditBase": true,
      "canExtendBase": true,
      "reservedSlots": 0
    },
    {
      "name": "Friend",
      "password": "TROQUE-ESTA-SENHA-FRIEND",
      "canKickBan": false,
      "canAccessInventories": true,
      "canEditBase": true,
      "canExtendBase": false,
      "reservedSlots": 0
    },
    {
      "name": "Guest",
      "password": "TROQUE-ESTA-SENHA-GUEST",
      "canKickBan": false,
      "canAccessInventories": false,
      "canEditBase": false,
      "canExtendBase": false,
      "reservedSlots": 0
    }
  ]
}
JSON
  chown steam:steam /opt/game/enshrouded_server.json
  echo "enshrouded_server.json criado - TROQUE AS SENHAS antes de liberar o servidor"
else
  echo "enshrouded_server.json ja existe, mantido"
fi

cat > /opt/game/start-enshrouded.sh <<"SH"
#!/usr/bin/env bash
# Sobe o enshrouded_server.exe com o runtime configurado no deploy (Proton).
# Todo o ambiente - prefixo, WINEDLLOVERRIDES, XDG_RUNTIME_DIR - vive no win-run,
# instalado pelo provision-game-lxc.sh e compartilhado entre os jogos.
# A porta NAO vem por argumento: o servidor le tudo do enshrouded_server.json.
set -Eeuo pipefail
cd /opt/game
exec win-run /opt/game/enshrouded_server.exe
SH
chmod 755 /opt/game/start-enshrouded.sh
chown steam:steam /opt/game/start-enshrouded.sh
'

# Cadastro automatico no painel (usado pelo deploy-docker.ps1)
CONFIG_PATH=/opt/game
CONFIG_FILES=/opt/game/enshrouded_server.json
QUERY_PORT=0
PLAYER_SOURCE=log

# Dicas pos-instalacao
CONFIG_HINT="/opt/game/enshrouded_server.json - ajuste name, slotCount (max 16) e as senhas de userGroups (Admin/Friend/Guest). O jogador entra digitando IP:15637 e a senha do grupo dele. Pare o servidor antes de editar (systemctl stop enshrouded)."
SAVE_HINT="/opt/game/savegame/"
