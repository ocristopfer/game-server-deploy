# Enshrouded - definicao do jogo
# Fonte: Steam app 2278520 (Enshrouded Dedicated Server)
#
# ATENCAO: a Keen Games NAO publica build Linux do servidor dedicado.
# Este template baixa o build Windows (STEAM_PLATFORM=windows) e roda via Wine
# dentro do container. E o mesmo caminho usado pelo LinuxGSM e pelas imagens
# Docker da comunidade - funciona bem, mas consome mais RAM que um build nativo.

GAME_KEY=enshrouded
GAME_DISPLAY_NAME="Enshrouded"
STEAM_APP_ID=2278520

# Sem build nativo Linux: o SteamCMD precisa baixar os arquivos de Windows.
STEAM_PLATFORM=windows

# O binario e um .exe, entao o start real e o wrapper criado no POST_INSTALL_CMD.
# O jogo NAO aceita porta por linha de comando - vem do enshrouded_server.json.
START_SCRIPT=start-enshrouded.sh
START_ARGS=""

# Portas (formato: porta/protocolo, separadas por espaco)
GAME_PORT=15637
GAME_PORTS="15636/udp 15637/udp"
PORT_NOTES="15637/UDP e a porta principal (queryPort) - e a que o jogador digita no cliente. 15636/UDP (gamePort) deixou de ser usada a partir do Content Update #2, mas abrir as duas evita dor de cabeca com servidor em versao antiga. Sao UDP puro; nao abra TCP. O jogo nao publica query A2S da Steam, entao a contagem de jogadores do painel sai do log."

# Recursos recomendados (usados se nao definidos no .env)
# A Keen Games recomenda 16GB para 16 jogadores; o Wine soma um pouco em cima disso.
# O download do build Windows fica em ~12GB, por isso 40GB de disco.
RECOMMENDED_MEMORY=16384
RECOMMENDED_CORES=6
RECOMMENDED_DISK_GB=40

# Pre-instalacao: o Wine precisa existir ANTES do SteamCMD baixar o build Windows.
# O servidor e um .exe 64 bits, entao o pacote wine (64) basta; a parte i386 e
# opcional (alguns instaladores auxiliares da Steam sao 32 bits) e por isso nao
# derruba o deploy se o nome do pacote mudar entre versoes do Debian.
PRE_INSTALL_CMD='
set -e
export DEBIAN_FRONTEND=noninteractive
if command -v wine >/dev/null 2>&1; then
  echo "Wine ja instalado: $(wine --version)"
else
  dpkg --add-architecture i386
  apt-get update
  apt-get install -y --no-install-recommends wine || apt-get install -y --no-install-recommends wine64
  apt-get install -y --no-install-recommends wine32:i386 || echo "wine32:i386 indisponivel, seguindo apenas com 64 bits"
  command -v wine >/dev/null 2>&1 || { echo "Wine nao ficou disponivel apos a instalacao"; exit 1; }
  echo "Wine instalado: $(wine --version)"
fi
'

# Pos-instalacao:
# 1) cria o prefixo do Wine (64 bits) do usuario steam, uma unica vez
# 2) semeia o enshrouded_server.json se ainda nao existir
# 3) escreve o wrapper que o systemd vai chamar como START_SCRIPT
POST_INSTALL_CMD='
set -e
install -d -o steam -g steam /home/steam/.wine-enshrouded
if [ ! -f /home/steam/.wine-enshrouded/system.reg ]; then
  echo "Criando prefixo do Wine (primeira vez, demora um pouco)..."
  su - steam -c "WINEPREFIX=/home/steam/.wine-enshrouded WINEARCH=win64 WINEDEBUG=-all wineboot --init" || true
  su - steam -c "WINEPREFIX=/home/steam/.wine-enshrouded wineserver -w" || true
else
  echo "Prefixo do Wine ja existe, mantido"
fi

install -d -o steam -g steam /opt/game/savegame /opt/game/logs

if [ ! -s /opt/game/enshrouded_server.json ]; then
  cat > /opt/game/enshrouded_server.json <<"JSON"
{
  "name": "Enshrouded Server",
  "saveDirectory": "./savegame",
  "logDirectory": "./logs",
  "ip": "0.0.0.0",
  "gamePort": 15636,
  "queryPort": 15637,
  "slotCount": 16,
  "voiceChatMode": "Proximity",
  "enableVoiceChat": false,
  "enableTextChat": false,
  "userGroups": [
    {
      "name": "Admin",
      "password": "TROQUE-ESTA-SENHA-ADMIN",
      "canKickBan": true,
      "canAccessInventories": true,
      "canEditBase": true,
      "canExtendBase": true,
      "reservedSlots": 0
    },
    {
      "name": "Friend",
      "password": "TROQUE-ESTA-SENHA-FRIEND",
      "canKickBan": false,
      "canAccessInventories": true,
      "canEditBase": true,
      "canExtendBase": false,
      "reservedSlots": 0
    },
    {
      "name": "Guest",
      "password": "TROQUE-ESTA-SENHA-GUEST",
      "canKickBan": false,
      "canAccessInventories": false,
      "canEditBase": false,
      "canExtendBase": false,
      "reservedSlots": 0
    }
  ]
}
JSON
  chown steam:steam /opt/game/enshrouded_server.json
  echo "enshrouded_server.json criado - TROQUE AS SENHAS antes de liberar o servidor"
else
  echo "enshrouded_server.json ja existe, mantido"
fi

cat > /opt/game/start-enshrouded.sh <<"SH"
#!/usr/bin/env bash
# Sobe o enshrouded_server.exe via Wine (o jogo nao tem build Linux).
# A porta NAO vem por argumento - o servidor le tudo do enshrouded_server.json.
set -Eeuo pipefail
export WINEPREFIX=/home/steam/.wine-enshrouded
export WINEARCH=win64
export WINEDEBUG=-all
export WINEDLLOVERRIDES="mscoree,mshtml="
cd /opt/game
exec wine /opt/game/enshrouded_server.exe
SH
chmod 755 /opt/game/start-enshrouded.sh
chown steam:steam /opt/game/start-enshrouded.sh
'

# Dicas pos-instalacao
CONFIG_HINT="/opt/game/enshrouded_server.json - ajuste name, slotCount (max 16) e as senhas de userGroups (Admin/Friend/Guest). O jogador entra digitando IP:15637 e a senha do grupo dele. Pare o servidor antes de editar (systemctl stop enshrouded)."
SAVE_HINT="/opt/game/savegame/"
