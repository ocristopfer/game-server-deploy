# Palworld - game definition
# Source: Steam app 2394010 (Palworld Dedicated Server, native Linux build)

GAME_KEY=palworld
GAME_DISPLAY_NAME="Palworld"
STEAM_APP_ID=2394010

# Startup script inside the game folder ({PORT} is replaced by the final port)
START_SCRIPT=PalServer.sh
# -publiclobby: the server joins the community server list (as in LinuxGSM).
# Without it you can only join via IP:port. For a private server, remove it here and redeploy.
START_ARGS="-port={PORT} -queryport={QUERY_PORT} -publiclobby -useperfthreads -NoAsyncLoadingThread -UseMultithreadForDS"

# Ports (format: port/protocol, separated by spaces)
GAME_PORT=8211
GAME_PORTS="8211/udp 27015/udp"
# 0 = the game's default ports, always (decision: curated games do not use the broker's assigned
# range; a second instance of the same game is rejected because the port is taken). The {PORT} in
# START_ARGS stays: with a fixed port it receives the default number. 1 = broker range.
PORTS_SHIFTABLE=0
PORT_NOTES="8211/UDP e a porta do jogo; 27015/UDP e a query da Steam (necessaria para o servidor aparecer na lista da comunidade). A API REST (8212/TCP) e o RCON (25575/TCP) so existem se habilitados no .ini - NAO exponha nenhum dos dois no roteador; o painel fala com a API por dentro do container, via SSH."

# Recommended resources (used if not defined in .env)
# The server grows in memory with the world/players; 8GB is the practical minimum.
RECOMMENDED_MEMORY=16384
RECOMMENDED_CORES=4
RECOMMENDED_DISK_GB=32

# Post-install:
# 1) PalServer.sh requires steamclient.so in ~/.steam/sdk64 (otherwise the server does not register with Steam)
# 2) The PalWorldSettings.ini generated on the first start comes empty - we seed it with the Default
POST_INSTALL_CMD='
install -d -o steam -g steam /home/steam/.steam/sdk64
ln -sf /opt/steamcmd/linux64/steamclient.so /home/steam/.steam/sdk64/steamclient.so
chown -h steam:steam /home/steam/.steam/sdk64/steamclient.so

cfg_dir=/opt/game/Pal/Saved/Config/LinuxServer
install -d -o steam -g steam "$cfg_dir"
if [ ! -s "$cfg_dir/PalWorldSettings.ini" ]; then
  install -o steam -g steam -m 0644 /opt/game/DefaultPalWorldSettings.ini "$cfg_dir/PalWorldSettings.ini"
  echo "PalWorldSettings.ini criado a partir do DefaultPalWorldSettings.ini"
else
  echo "PalWorldSettings.ini ja existe, mantido"
fi
'

# Automatic registration in the panel (used by deploy-docker.ps1)
# CONFIG_FILES is what the "Config" screen opens as a form, field by field.
CONFIG_PATH=/opt/game/Pal/Saved/Config/LinuxServer
CONFIG_FILES=/opt/game/Pal/Saved/Config/LinuxServer/PalWorldSettings.ini
QUERY_PORT=27015
# The A2S query on 27015 counts; the NAMES come from the log, because Palworld does not answer
# A2S_PLAYER. If the query does not answer, the log takes over the count. Whoever turns on the REST API
# (see the README) can switch to the "HTTP API" source, which gives name, level and ping.
PLAYER_SOURCE=a2s

# With (?P<name>...) on BOTH sides the panel says exactly WHO is online.
# Empty LOG_PATH = service output.
LOG_PATH=
JOIN_RE='\[LOG\] (?P<name>.+?) joined the server\.'
LEAVE_RE='\[LOG\] (?P<name>.+?) left the server\.'

# Folders the panel's Backups screen stores in the .tar.gz (comma separated).
# It is the game SAVE, not the root: the whole /opt/game carries the binaries that SteamCMD
# downloads again for free. A path that does not exist yet is skipped with a warning, so it may
# point to the folder that only appears on the first start.
BACKUP_PATHS=/opt/game/Pal/Saved/SaveGames

# Post-install hints
CONFIG_HINT="/opt/game/Pal/Saved/Config/LinuxServer/PalWorldSettings.ini - ajuste ServerName, ServerPassword, AdminPassword, ServerPlayerMaxNum e PublicPort dentro de OptionSettings=(...). Para o painel mostrar os NOMES dos jogadores (e nao so a contagem), ligue a API REST no mesmo bloco: RESTAPIEnabled=True, RESTAPIPort=8212, AdminPassword=<senha forte>; depois, no painel, Configurar contagem > API HTTP > http://127.0.0.1:8212/v1/api/players com basic:admin:<a mesma senha>. Pare o servidor antes de editar (systemctl stop palworld)."
SAVE_HINT="/opt/game/Pal/Saved/SaveGames/0/"
