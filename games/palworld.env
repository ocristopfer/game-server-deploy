# Palworld - definicao do jogo
# Fonte: Steam app 2394010 (Palworld Dedicated Server, build nativo Linux)

GAME_KEY=palworld
GAME_DISPLAY_NAME="Palworld"
STEAM_APP_ID=2394010

# Script de inicializacao dentro da pasta do jogo ({PORT} e substituido pela porta final)
START_SCRIPT=PalServer.sh
# -publiclobby: o servidor entra na lista de servidores da comunidade (como no LinuxGSM).
# Sem ele so se entra por IP:porta. Para um servidor privado, tire daqui e da o deploy.
START_ARGS="-port={PORT} -queryport={QUERY_PORT} -publiclobby -useperfthreads -NoAsyncLoadingThread -UseMultithreadForDS"

# Portas (formato: porta/protocolo, separadas por espaco)
GAME_PORT=8211
GAME_PORTS="8211/udp 27015/udp"
# 0 = portas padrao do jogo, sempre (decisao: curado nao usa a faixa sorteada do broker;
# uma segunda instancia do mesmo jogo e recusada com a porta ocupada). O {PORT} do
# START_ARGS continua: com porta fixa ele recebe o numero padrao. 1 = faixa do broker.
PORTS_SHIFTABLE=0
PORT_NOTES="8211/UDP e a porta do jogo; 27015/UDP e a query da Steam (necessaria para o servidor aparecer na lista da comunidade). A API REST (8212/TCP) e o RCON (25575/TCP) so existem se habilitados no .ini - NAO exponha nenhum dos dois no roteador; o painel fala com a API por dentro do container, via SSH."

# Recursos recomendados (usados se nao definidos no .env)
# O servidor cresce de memoria conforme o mundo/jogadores; 8GB e o minimo pratico.
RECOMMENDED_MEMORY=16384
RECOMMENDED_CORES=4
RECOMMENDED_DISK_GB=32

# Pos-instalacao:
# 1) PalServer.sh exige steamclient.so em ~/.steam/sdk64 (senao o servidor nao registra na Steam)
# 2) O PalWorldSettings.ini gerado no primeiro start vem vazio - semeamos com o Default
POST_INSTALL_CMD='
install -d -o steam -g steam /home/steam/.steam/sdk64
ln -sf /opt/steamcmd/linux64/steamclient.so /home/steam/.steam/sdk64/steamclient.so
chown -h steam:steam /home/steam/.steam/sdk64/steamclient.so

cfg_dir=/opt/game/Pal/Saved/Config/LinuxServer
install -d -o steam -g steam "$cfg_dir"
if [ ! -s "$cfg_dir/PalWorldSettings.ini" ]; then
  install -o steam -g steam -m 0644 /opt/game/DefaultPalWorldSettings.ini "$cfg_dir/PalWorldSettings.ini"
  echo "PalWorldSettings.ini criado a partir do DefaultPalWorldSettings.ini"
else
  echo "PalWorldSettings.ini ja existe, mantido"
fi
'

# Cadastro automatico no painel (usado pelo deploy-docker.ps1)
# CONFIG_FILES e o que a tela "Config" abre como formulario, campo a campo.
CONFIG_PATH=/opt/game/Pal/Saved/Config/LinuxServer
CONFIG_FILES=/opt/game/Pal/Saved/Config/LinuxServer/PalWorldSettings.ini
QUERY_PORT=27015
# Pelo log, e nao pela consulta da Steam: o LinuxGSM nao consulta o Palworld por A2S
# (querymode 1, querytype "palworld", que e a API REST dele), e o log ja diz QUEM entrou.
# A 27015 continua aberta: e ela que poe o servidor na lista da comunidade.
PLAYER_SOURCE=log

# Com (?P<name>...) nos DOIS lados o painel diz exatamente QUEM esta online.
# LOG_PATH vazio = saida do servico.
LOG_PATH=
JOIN_RE='\[LOG\] (?P<name>.+?) joined the server\.'
LEAVE_RE='\[LOG\] (?P<name>.+?) left the server\.'

# Pastas que a tela Backups do painel guarda no .tar.gz (separadas por virgula).
# E o SAVE do jogo, nao a raiz: /opt/game inteiro leva os binarios que o SteamCMD
# rebaixa de graca. Caminho que ainda nao existe e ignorado com aviso, entao pode
# apontar a pasta que so nasce no primeiro start.
BACKUP_PATHS=/opt/game/Pal/Saved/SaveGames

# Dicas pos-instalacao
CONFIG_HINT="/opt/game/Pal/Saved/Config/LinuxServer/PalWorldSettings.ini - ajuste ServerName, ServerPassword, AdminPassword, ServerPlayerMaxNum e PublicPort dentro de OptionSettings=(...). Para o painel mostrar os NOMES dos jogadores (e nao so a contagem), ligue a API REST no mesmo bloco: RESTAPIEnabled=True, RESTAPIPort=8212, AdminPassword=<senha forte>; depois, no painel, Configurar contagem > API HTTP > http://127.0.0.1:8212/v1/api/players com basic:admin:<a mesma senha>. Pare o servidor antes de editar (systemctl stop palworld)."
SAVE_HINT="/opt/game/Pal/Saved/SaveGames/0/"
