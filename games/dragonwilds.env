# RuneScape: Dragonwilds - definicao do jogo
# Fonte: Steam app 4019830 (RuneScape Dragonwilds: Dedicated Server, build nativo Linux)

GAME_KEY=dragonwilds
GAME_DISPLAY_NAME="RuneScape: Dragonwilds"
STEAM_APP_ID=4019830

# Script de inicializacao dentro da pasta do jogo ({PORT} e substituido pela porta final)
START_SCRIPT=RSDragonwildsServer.sh
START_ARGS="-log -Port={PORT}"

# Portas (formato: porta/protocolo, separadas por espaco)
GAME_PORT=7777
GAME_PORTS="7777/udp"
PORT_NOTES="Cada mundo adicional rodando no mesmo servidor usa a porta seguinte (7778, 7779...), por isso a faixa 7777-7779 fica reservada a este jogo no mapa de portas. E so isso: o servidor NAO abre query A2S da Steam, RCON nem API HTTP - o DedicatedServer.ini nao tem chave nenhuma para isso e nao existe navegador de servidores no jogo (entra-se por IP direto). Guias de hosting que mandam liberar 27015 estao copiando texto de outros jogos Unreal. Por isso a contagem de jogadores do painel so pode sair do log."

# Recursos recomendados (usados se nao definidos no .env)
RECOMMENDED_MEMORY=8192
RECOMMENDED_CORES=4
RECOMMENDED_DISK_GB=32

# Cadastro automatico no painel (usado pelo deploy-docker.ps1)
# O DedicatedServer.ini so nasce no primeiro start; ate la a tela Config avisa que
# o arquivo ainda nao existe (o botao "Procurar" acha o caminho final).
CONFIG_PATH=/opt/game/RSDragonwilds/Saved/Config/LinuxServer
CONFIG_FILES=/opt/game/RSDragonwilds/Saved/Config/LinuxServer/DedicatedServer.ini
QUERY_PORT=0
PLAYER_SOURCE=log

# Contagem pelo log (alternativa). Com (?P<name>...) nos DOIS lados o painel
# diz exatamente QUEM esta online. LOG_PATH vazio = saida do servico.
LOG_PATH=
JOIN_RE='PlayerChar entered world \[Account\[[^\]]*\] Character Name\[(?P<name>[^\]]+)\]'
LEAVE_RE='Player Removed from session \[[^\]]*\]-\[(?P<name>[^\]]+)\]'

# Pastas que a tela Backups do painel guarda no .tar.gz (separadas por virgula).
# E o SAVE do jogo, nao a raiz: /opt/game inteiro leva os binarios que o SteamCMD
# rebaixa de graca. Caminho que ainda nao existe e ignorado com aviso, entao pode
# apontar a pasta que so nasce no primeiro start.
BACKUP_PATHS=/opt/game/RSDragonwilds/Saved/SaveGames

# Dicas pos-instalacao
CONFIG_HINT="DedicatedServer.ini criado no primeiro start (localize com: find /opt/game -name DedicatedServer.ini) - nome do servidor, senha do mundo, senha de admin, OwnerID"
SAVE_HINT="/opt/game/RSDragonwilds/Saved/SaveGames/"
