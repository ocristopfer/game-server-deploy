# RuneScape: Dragonwilds - game definition
# Source: Steam app 4019830 (RuneScape Dragonwilds: Dedicated Server, native Linux build)

GAME_KEY=dragonwilds
GAME_DISPLAY_NAME="RuneScape: Dragonwilds"
STEAM_APP_ID=4019830

# Startup script inside the game folder ({PORT} is replaced by the final port)
START_SCRIPT=RSDragonwildsServer.sh
START_ARGS="-log -Port={PORT}"

# Ports (format: port/protocol, separated by spaces)
GAME_PORT=7777
GAME_PORTS="7777/udp"
# 0 = the game's default ports, always (decision: curated games do not use the broker's assigned
# range; a second instance of the same game is rejected because the port is taken). The {PORT} in
# START_ARGS stays: with a fixed port it receives the default number. 1 = broker range.
PORTS_SHIFTABLE=0
PORT_NOTES="Cada mundo adicional rodando no mesmo servidor usa a porta seguinte (7778, 7779...), por isso a faixa 7777-7779 fica reservada a este jogo no mapa de portas. E so isso: o servidor NAO abre query A2S da Steam, RCON nem API HTTP - o DedicatedServer.ini nao tem chave nenhuma para isso e nao existe navegador de servidores no jogo (entra-se por IP direto). Medido no CT 302 em 2026-10-03: o servidor usa EOS da Epic (libEOSSDK, LogRedpointEOS) e nao traz biblioteca de servidor da Steam; abre so 7777, 8888 e uma porta alta, e nenhuma responde A2S, nem por loopback. A doc da Jagex nao tem query port nem argumento para isso. Guias de hosting que mandam liberar 27015 estao copiando texto de outros jogos Unreal. Por isso o painel conta pelas conversas ativas na porta do jogo (firewall do CT) e tira os nomes do log."

# Recommended resources (used if not defined in .env)
RECOMMENDED_MEMORY=8192
RECOMMENDED_CORES=4
RECOMMENDED_DISK_GB=32

# Automatic registration in the panel (used by deploy-docker.ps1)
# DedicatedServer.ini only appears on the first start; until then the Config screen warns that
# the file does not exist yet (the "Browse" button finds the final path).
CONFIG_PATH=/opt/game/RSDragonwilds/Saved/Config/LinuxServer
CONFIG_FILES=/opt/game/RSDragonwilds/Saved/Config/LinuxServer/DedicatedServer.ini
QUERY_PORT=0
# With no query (EOS), the NUMBER comes from active conversations on the game port, counted by
# the CT firewall (FW_PRESENCE_PORTS): it does not depend on the game logging who dropped.
# The NAMES come from the log below, and the log takes over the count if the CT lacks the set.
PLAYER_SOURCE=net
# Slots: 6, fixed by Jagex (no key in the .ini, no argument). Counting by connections does not
# know the total, so this is where the panel gets the "/6" from.
MAX_PLAYERS=6

# Counting by log (alternative). With (?P<name>...) on BOTH sides the panel
# says exactly WHO is online. Empty LOG_PATH = service output.
LOG_PATH=
JOIN_RE='PlayerChar entered world \[Account\[[^\]]*\] Character Name\[(?P<name>[^\]]+)\]'
LEAVE_RE='Player Removed from session \[[^\]]*\]-\[(?P<name>[^\]]+)\]'

# Folders the panel's Backups screen stores in the .tar.gz (comma separated).
# It is the game SAVE, not the root: the whole /opt/game carries the binaries that SteamCMD
# downloads again for free. A path that does not exist yet is skipped with a warning, so it may
# point to the folder that only appears on the first start.
BACKUP_PATHS=/opt/game/RSDragonwilds/Saved/SaveGames

# Post-install hints
CONFIG_HINT="DedicatedServer.ini criado no primeiro start (localize com: find /opt/game -name DedicatedServer.ini) - nome do servidor, senha do mundo, senha de admin, OwnerID"
SAVE_HINT="/opt/game/RSDragonwilds/Saved/SaveGames/"
