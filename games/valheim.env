# Valheim - game definition
# Source: Steam app 896660 (Valheim Dedicated Server, native Linux build)
#
# Curated (and not the LinuxGSM suggestion) because the binary alone does not start: the
# official start_server.sh exports SteamAppId and LD_LIBRARY_PATH before calling it, and the
# importer deliberately strips name, world and password. Without that Steam does not initialize and the
# server dies right after the "GPU Device: Unknown" log line - which is noise, not the error.

GAME_KEY=valheim
GAME_DISPLAY_NAME="Valheim"
STEAM_APP_ID=896660

# The wrapper (generated in POST_INSTALL_CMD) reads name, world and password from valheim-server.ini and
# calls the binary with the environment of the official start_server.sh.
# -queryport is not a Valheim argument: the wrapper only CHECKS it (the game always answers the
# query on port+1, with no option to change it) and drops it before calling the binary.
START_SCRIPT=start-valheim.sh
START_ARGS="-port {PORT} -queryport {QUERY_PORT} -saveinterval 1800 -backups 4"

# Ports: the game port and the next one (Steam query, without it the server does not show up in the
# list). If the game ever goes back to shifting ports, the ORDER here matters: the broker numbers
# the block in the order of this list, and that is what keeps the query one above the game port.
GAME_PORT=2456
GAME_PORTS="2456/udp 2457/udp"
# 0 = the game's default ports, always (decision: curated games do not use the broker's assigned
# range; a second instance of the same game is rejected because the port is taken). The {PORT} in
# START_ARGS stays: with a fixed port it receives the default number. 1 = broker range.
PORTS_SHIFTABLE=0
PORT_NOTES="2456/UDP e a porta do jogo; 2457/UDP e a consulta da Steam (sempre a porta do jogo + 1, e o Valheim nao aceita outra). Sem a 2457 o servidor funciona por IP:porta, mas nao aparece na lista da comunidade."

RECOMMENDED_MEMORY=4096
RECOMMENDED_CORES=2
RECOMMENDED_DISK_GB=16

# Post-install:
# 1) valheim-server.ini: only created if it does not exist (the password of whoever configured it stays).
#    The initial password is random: with -public 1 Valheim rejects an empty or short password.
# 2) start-valheim.sh: rewritten on every deploy (it is code, not configuration).
POST_INSTALL_CMD='
set -e
cfg=/opt/game/valheim-server.ini
install -d -o steam -g steam /opt/game/saves
if [ ! -s "$cfg" ]; then
  password="$(od -An -N6 -tx1 /dev/urandom | tr -d " \n")"
  cat > "$cfg" <<INI
; Lido pelo start-valheim.sh a cada start. Reinicie o servidor depois de mudar.
[server]
; Nome na lista de servidores.
name=Valheim no painel
; Nome do mundo (arquivo em /opt/game/saves/worlds_local). Trocar cria um mundo NOVO.
world=Dedicated
; Minimo 5 caracteres, e nao pode estar contida no nome (regra do proprio Valheim).
password=${password}
; 1 = aparece na lista da comunidade; 0 = so por IP:porta.
public=1
; 1 = aceita Xbox/Game Pass, pelo relay da PlayFab. Deixa a contagem de jogadores do
; painel (consulta da Steam) sem resposta, por isso vem desligado.
crossplay=0
; Dificuldade do mundo (vazio = normal): casual, easy, hard, hardcore, immersive, hammer.
; Vale para o mundo inteiro; mudar num mundo ja criado muda as regras dali em diante.
preset=
INI
  chown steam:steam "$cfg"
  chmod 0640 "$cfg"
  echo "valheim-server.ini criado com senha sorteada - veja/troque na tela Config do painel"
else
  echo "valheim-server.ini ja existe, mantido"
fi

cat > /opt/game/start-valheim.sh <<"SH"
#!/usr/bin/env bash
# Starts the Valheim server like the official start_server.sh, but with name, world and password
# taken from valheim-server.ini (the official one has them hardcoded in the script, and SteamCMD
# overwrites it on every update).
set -Eeuo pipefail

cfg=/opt/game/valheim-server.ini
port=""
query=""
args=()
while (( $# )); do
  case "$1" in
    -port) port="${2:-}"; shift 2 ;;
    -queryport) query="${2:-}"; shift 2 ;;
    *) args+=("$1"); shift ;;
  esac
done

fail() { echo "start-valheim: $*" >&2; exit 1; }

[[ "$port" =~ ^[0-9]+$ ]] || fail "sem -port numerico"
# Valheim ALWAYS answers the query on port+1. If what was opened in the firewall is not
# that, the server would come up invisible in the list with no error at all: better to stop here and say so.
if [[ -n "$query" ]] && (( query != port + 1 )); then
  fail "porta de consulta $query, mas o Valheim so usa $((port + 1)) (porta do jogo + 1)"
fi

name="Valheim"
world="Dedicated"
password=""
public=1
crossplay=0
preset=""
# Read line by line, never with source: the file is edited through the Config screen, and
# source would execute whatever was in it.
re="^[[:space:]]*([A-Za-z_]+)[[:space:]]*=[[:space:]]*(.*[^[:space:]])?[[:space:]]*$"
[[ -r "$cfg" ]] || fail "$cfg nao existe ou nao pode ser lido"
while IFS= read -r line; do
  [[ "$line" =~ $re ]] || continue
  value="${BASH_REMATCH[2]}"
  case "${BASH_REMATCH[1]}" in
    name) name="$value" ;;
    world) world="$value" ;;
    password) password="$value" ;;
    public) public="$value" ;;
    crossplay) crossplay="$value" ;;
    preset) preset="$value" ;;
  esac
done < <(tr -d "\r" < "$cfg")

# The rules Valheim checks: it exits with a message that gets lost in the middle of the Unity
# log. Checked here, the reason is the last line in the journal.
(( ${#password} >= 5 )) || fail "password em $cfg precisa de ao menos 5 caracteres"
[[ "$name" != *"$password"* ]] || fail "password nao pode estar contida no name ($cfg)"
[[ "$public" == 0 || "$public" == 1 ]] || fail "public em $cfg deve ser 0 ou 1"
[[ "$world" =~ ^[A-Za-z0-9_-]+$ ]] || fail "world em $cfg: so letras, numeros, _ e -"
# Closed list (the game presets): Valheim SILENTLY ignores a wrong name, and the
# world comes up on normal difficulty without anyone knowing the setting did not apply.
case "$preset" in
  ""|normal|casual|easy|hard|hardcore|immersive|hammer) ;;
  *) fail "preset em $cfg: use normal, casual, easy, hard, hardcore, immersive ou hammer" ;;
esac

flags=()
[[ "$crossplay" == 1 ]] && flags+=(-crossplay)
[[ -n "$preset" ]] && flags+=(-preset "$preset")

export SteamAppId=892970
export LD_LIBRARY_PATH="/opt/game/linux64${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
echo "start-valheim: porta $port, mundo $world, publico $public, crossplay $crossplay, preset ${preset:-normal}"
cd /opt/game
exec /opt/game/valheim_server.x86_64 -nographics -batchmode \
  -name "$name" -port "$port" -world "$world" -password "$password" -public "$public" \
  -savedir /opt/game/saves "${flags[@]}" "${args[@]}"
SH
chmod 755 /opt/game/start-valheim.sh
chown steam:steam /opt/game/start-valheim.sh
'

# Automatic registration in the panel
CONFIG_PATH=/opt/game
CONFIG_FILES=/opt/game/valheim-server.ini
QUERY_PORT=2457
PLAYER_SOURCE=a2s

# Counting by log (alternative): Valheim writes the name of who joins, but not of
# who leaves, so the Steam query is the right source.
LOG_PATH=
JOIN_RE=
LEAVE_RE=

# The world (.db/.fwl) and the game's own automatic backups.
BACKUP_PATHS=/opt/game/saves/worlds_local

CONFIG_HINT="/opt/game/valheim-server.ini - name, world, password (5+ caracteres, fora do nome), public, crossplay e preset (dificuldade). Reinicie o servidor depois de mudar."
SAVE_HINT="/opt/game/saves/worlds_local/"
