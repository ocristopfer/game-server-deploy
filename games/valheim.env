# Valheim - definicao do jogo
# Fonte: Steam app 896660 (Valheim Dedicated Server, build nativo Linux)
#
# Curado (e nao a sugestao do LinuxGSM) porque o binario sozinho nao sobe: o
# start_server.sh oficial exporta SteamAppId e LD_LIBRARY_PATH antes de chama-lo, e o
# importador corta de proposito nome, mundo e senha. Sem isso a Steam nao inicializa e o
# servidor cai logo depois do "GPU Device: Unknown" do log - que e ruido, e nao o erro.

GAME_KEY=valheim
GAME_DISPLAY_NAME="Valheim"
STEAM_APP_ID=896660

# O wrapper (gerado no POST_INSTALL_CMD) le nome, mundo e senha do valheim-server.ini e
# chama o binario com o ambiente do start_server.sh oficial.
# -queryport nao e argumento do Valheim: o wrapper so o CONFERE (o jogo sempre responde a
# consulta na porta+1, sem opcao para mudar) e o descarta antes de chamar o binario.
START_SCRIPT=start-valheim.sh
START_ARGS="-port {PORT} -queryport {QUERY_PORT} -saveinterval 1800 -backups 4"

# Portas: a do jogo e a seguinte (consulta da Steam, sem ela o servidor nao aparece na
# lista). A ORDEM aqui importa para o broker: ele numera o bloco na ordem desta lista, e
# e isso que mantem a consulta exatamente uma acima da porta do jogo.
GAME_PORT=2456
GAME_PORTS="2456/udp 2457/udp"
PORTS_SHIFTABLE=1
PORT_NOTES="2456/UDP e a porta do jogo; 2457/UDP e a consulta da Steam (sempre a porta do jogo + 1, e o Valheim nao aceita outra). Sem a 2457 o servidor funciona por IP:porta, mas nao aparece na lista da comunidade."

RECOMMENDED_MEMORY=4096
RECOMMENDED_CORES=2
RECOMMENDED_DISK_GB=16

# Pos-instalacao:
# 1) valheim-server.ini: so criado se nao existir (a senha de quem ja configurou fica).
#    A senha inicial e sorteada: com -public 1 o Valheim recusa senha vazia ou curta.
# 2) start-valheim.sh: reescrito a cada deploy (e codigo, nao configuracao).
POST_INSTALL_CMD='
set -e
cfg=/opt/game/valheim-server.ini
install -d -o steam -g steam /opt/game/saves
if [ ! -s "$cfg" ]; then
  password="$(od -An -N6 -tx1 /dev/urandom | tr -d " \n")"
  cat > "$cfg" <<INI
; Lido pelo start-valheim.sh a cada start. Reinicie o servidor depois de mudar.
[server]
; Nome na lista de servidores.
name=Valheim no painel
; Nome do mundo (arquivo em /opt/game/saves/worlds_local). Trocar cria um mundo NOVO.
world=Dedicated
; Minimo 5 caracteres, e nao pode estar contida no nome (regra do proprio Valheim).
password=${password}
; 1 = aparece na lista da comunidade; 0 = so por IP:porta.
public=1
; 1 = aceita Xbox/Game Pass, pelo relay da PlayFab. Deixa a contagem de jogadores do
; painel (consulta da Steam) sem resposta, por isso vem desligado.
crossplay=0
; Dificuldade do mundo (vazio = normal): casual, easy, hard, hardcore, immersive, hammer.
; Vale para o mundo inteiro; mudar num mundo ja criado muda as regras dali em diante.
preset=
INI
  chown steam:steam "$cfg"
  chmod 0640 "$cfg"
  echo "valheim-server.ini criado com senha sorteada - veja/troque na tela Config do painel"
else
  echo "valheim-server.ini ja existe, mantido"
fi

cat > /opt/game/start-valheim.sh <<"SH"
#!/usr/bin/env bash
# Sobe o servidor do Valheim como o start_server.sh oficial, mas com nome, mundo e senha
# vindos do valheim-server.ini (o oficial os tem escritos no proprio script, e o SteamCMD
# o sobrescreve a cada atualizacao).
set -Eeuo pipefail

cfg=/opt/game/valheim-server.ini
port=""
query=""
args=()
while (( $# )); do
  case "$1" in
    -port) port="${2:-}"; shift 2 ;;
    -queryport) query="${2:-}"; shift 2 ;;
    *) args+=("$1"); shift ;;
  esac
done

fail() { echo "start-valheim: $*" >&2; exit 1; }

[[ "$port" =~ ^[0-9]+$ ]] || fail "sem -port numerico"
# O Valheim responde a consulta SEMPRE na porta+1. Se o que foi aberto no firewall nao for
# isso, o servidor subiria invisivel na lista sem erro nenhum: melhor parar aqui, dizendo.
if [[ -n "$query" ]] && (( query != port + 1 )); then
  fail "porta de consulta $query, mas o Valheim so usa $((port + 1)) (porta do jogo + 1)"
fi

name="Valheim"
world="Dedicated"
password=""
public=1
crossplay=0
preset=""
# Lido linha a linha, e nunca com source: o arquivo e editado pela tela Config, e
# source executaria o que estivesse la dentro.
re="^[[:space:]]*([A-Za-z_]+)[[:space:]]*=[[:space:]]*(.*[^[:space:]])?[[:space:]]*$"
[[ -r "$cfg" ]] || fail "$cfg nao existe ou nao pode ser lido"
while IFS= read -r line; do
  [[ "$line" =~ $re ]] || continue
  value="${BASH_REMATCH[2]}"
  case "${BASH_REMATCH[1]}" in
    name) name="$value" ;;
    world) world="$value" ;;
    password) password="$value" ;;
    public) public="$value" ;;
    crossplay) crossplay="$value" ;;
    preset) preset="$value" ;;
  esac
done < <(tr -d "\r" < "$cfg")

# As regras que o Valheim confere: ele sai com uma mensagem que some no meio do log da
# Unity. Conferidas aqui, o motivo e a ultima linha do journal.
(( ${#password} >= 5 )) || fail "password em $cfg precisa de ao menos 5 caracteres"
[[ "$name" != *"$password"* ]] || fail "password nao pode estar contida no name ($cfg)"
[[ "$public" == 0 || "$public" == 1 ]] || fail "public em $cfg deve ser 0 ou 1"
[[ "$world" =~ ^[A-Za-z0-9_-]+$ ]] || fail "world em $cfg: so letras, numeros, _ e -"
# Lista fechada (os presets do proprio jogo): um nome errado o Valheim ignora CALADO, e o
# mundo sobe na dificuldade normal sem ninguem saber que o ajuste nao pegou.
case "$preset" in
  ""|normal|casual|easy|hard|hardcore|immersive|hammer) ;;
  *) fail "preset em $cfg: use normal, casual, easy, hard, hardcore, immersive ou hammer" ;;
esac

flags=()
[[ "$crossplay" == 1 ]] && flags+=(-crossplay)
[[ -n "$preset" ]] && flags+=(-preset "$preset")

export SteamAppId=892970
export LD_LIBRARY_PATH="/opt/game/linux64${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
echo "start-valheim: porta $port, mundo $world, publico $public, crossplay $crossplay, preset ${preset:-normal}"
cd /opt/game
exec /opt/game/valheim_server.x86_64 -nographics -batchmode \
  -name "$name" -port "$port" -world "$world" -password "$password" -public "$public" \
  -savedir /opt/game/saves "${flags[@]}" "${args[@]}"
SH
chmod 755 /opt/game/start-valheim.sh
chown steam:steam /opt/game/start-valheim.sh
'

# Cadastro automatico no painel
CONFIG_PATH=/opt/game
CONFIG_FILES=/opt/game/valheim-server.ini
QUERY_PORT=2457
PLAYER_SOURCE=a2s

# Contagem pelo log (alternativa): o Valheim escreve o nome de quem entra, mas nao de
# quem sai, entao a consulta da Steam e a fonte certa.
LOG_PATH=
JOIN_RE=
LEAVE_RE=

# O mundo (.db/.fwl) e os backups automaticos do proprio jogo.
BACKUP_PATHS=/opt/game/saves/worlds_local

CONFIG_HINT="/opt/game/valheim-server.ini - name, world, password (5+ caracteres, fora do nome), public, crossplay e preset (dificuldade). Reinicie o servidor depois de mudar."
SAVE_HINT="/opt/game/saves/worlds_local/"
