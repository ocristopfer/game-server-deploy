# Real config (contains passwords) - commit only .env.example
.env

# Broker tokens (Proxmox and OPNsense). Commit only broker.secrets.env.example.
broker.secrets.env

# Stacks generated by deploy-docker.ps1 (the *.secret.env holds the Steam account password).
# They are regenerated on every deploy and only apply to the machine the deploy ran on.
/docker/stacks/

# Python bytecode (shows up when running the panel tests)
__pycache__/

# Local tooling environment (Flask/pytest/ruff/mypy for the editor and for running the
# tests without docker). NOT a panel dependency: in production Flask comes from apt.
# Recreate with: uv sync
.venv/

# Save games (worlds can be several MB)
*.sav

# Claude Code local
.claude/

# Output of the installer comparison sandbox (docker/ct-sandbox/compare.sh)
docker/ct-sandbox/.work/

# Packaged releases (tools/build-release.py) - build artifacts, not source.
dist/
# GENERATED inside the tarball by the packager; must never show up in the tree.
src/*/_build.py
