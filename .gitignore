# Config real (contem senha) - versione apenas o .env.example
.env

# Tokens do broker (Proxmox e OPNsense). Versione so o broker.secrets.env.example.
broker.secrets.env

# Stacks geradas pelo deploy-docker.ps1 (o *.secret.env leva a senha da conta Steam).
# Sao regeradas a cada deploy e valem so para a maquina onde o deploy rodou.
/docker/stacks/

# Bytecode do python (aparece ao rodar os testes do painel)
__pycache__/

# Ambiente local de ferramenta (Flask/pytest/ruff/mypy para o editor e para rodar os
# testes sem docker). NAO e dependencia do painel: em producao o Flask vem do apt.
# Recriar: uv sync
.venv/

# Save games (mundos podem ter varios MB)
*.sav
/The Girls World/

# Claude Code local
.claude/

# Saidas do sandbox de comparacao do instalador (docker/ct-sandbox/comparar.sh)
docker/ct-sandbox/.work/
